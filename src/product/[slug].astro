---
import ProductLayout from '../../layouts/ProductLayout.astro';

export async function getStaticPaths() {
  return [
    {
      params: {
        slug: 'american-eagle-tshirt'
      },
      props: {
        product: {
          title: 'American Eagle T-Shirt',
          price: '$16',
          oldPrice: '$24',
          image: 'https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=1200&auto=format&fit=crop',
          description: 'Modern POD storefront product page built with Astro.'
        }
      }
    }
  ];
}

const { product } = Astro.props;
---

<ProductLayout
  title={`${product.title} | AI PRINT`}
  description={product.description}
  image={product.image}
>

<section class="product-layout">

  <aside class="gallery">
    <div class="thumb active">
      <img src={product.image} alt={product.title} />
    </div>

    <div class="thumb">
      <img src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?q=80&w=1200&auto=format&fit=crop" alt="preview" />
    </div>

    <div class="thumb">
      <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?q=80&w=1200&auto=format&fit=crop" alt="preview" />
    </div>
  </aside>

  <section class="preview">
    <img id="mainImage" src={product.image} alt={product.title} />
  </section>

  <aside class="product-info">
    <h1>{product.title}</h1>

    <div class="seller">
      Designed and sold by Lily Rise
    </div>

    <div class="price-wrap">
      <div class="price">{product.price}</div>
      <div class="old-price">{product.oldPrice}</div>
    </div>

    <div class="label">Fit</div>

    <div class="options">
      <button class="active-btn">Male Fit</button>
      <button>Female Fit</button>
    </div>

    <div class="label">Style</div>

    <div class="options">
      <button class="active-btn">Classic</button>
      <button>Premium</button>
      <button>Vintage</button>
      <button>Heavyweight</button>
    </div>

    <div class="label">Size</div>

    <div class="options">
      <button>S</button>
      <button>M</button>
      <button class="active-btn">L</button>
      <button>XL</button>
      <button>2XL</button>
    </div>

    <button class="cart-btn">
      ADD TO CART
    </button>
  </aside>

</section>

<section class="description-section">
  <div class="description-box">
    <h2>Product Description</h2>

    <p>
      Ultra fast POD marketplace product page built using Astro with SEO optimized architecture, responsive ecommerce UI, and modern marketplace experience.
    </p>

    <p>
      Includes sticky sidebar, responsive gallery, Core Web Vitals optimization, lazy loading image support, and mobile-first responsive layouts.
    </p>
  </div>
</section>

<style>
.product-layout{
display:grid;
grid-template-columns:110px 1fr 420px;
gap:30px;
align-items:start;
}

.gallery{
display:flex;
flex-direction:column;
gap:14px;
}

.thumb{
background:#fff;
padding:6px;
border-radius:22px;
border:2px solid transparent;
box-shadow:var(--shadow);
cursor:pointer;
}

.thumb.active{
border-color:var(--primary);
}

.preview,
.product-info,
.description-box{
background:#fff;
border-radius:32px;
box-shadow:var(--shadow);
}

.preview{
padding:40px;
display:flex;
align-items:center;
justify-content:center;
min-height:720px;
}

.preview img{
max-width:600px;
}

.product-info{
padding:34px;
position:sticky;
top:110px;
}

.product-info h1{
font-size:38px;
line-height:1.1;
}

.seller{
margin-top:10px;
color:var(--muted);
}

.price-wrap{
display:flex;
align-items:center;
gap:14px;
margin:24px 0;
}

.price{
font-size:48px;
font-weight:900;
}

.old-price{
text-decoration:line-through;
color:#999;
}

.label{
margin:28px 0 12px;
font-weight:700;
}

.options{
display:flex;
flex-wrap:wrap;
gap:10px;
}

.options button{
padding:12px 18px;
border-radius:14px;
border:1px solid var(--border);
background:#fff;
cursor:pointer;
}

.active-btn{
background:var(--dark)!important;
color:#fff;
border-color:var(--dark)!important;
}

.cart-btn{
width:100%;
margin-top:30px;
padding:18px;
border:none;
border-radius:18px;
background:linear-gradient(135deg,#5865f2,#7c3aed);
color:#fff;
font-size:18px;
font-weight:900;
cursor:pointer;
}

.description-section{
margin-top:60px;
}

.description-box{
padding:40px;
line-height:1.9;
color:#555;
}

.description-box h2{
margin-bottom:20px;
color:var(--dark);
}

@media(max-width:1200px){
.product-layout{
grid-template-columns:1fr;
}

.gallery{
flex-direction:row;
}

.product-info{
position:relative;
top:0;
}
}

@media(max-width:768px){
.preview{
min-height:auto;
padding:20px;
}

.product-info{
padding:24px;
}

.product-info h1{
font-size:30px;
}
}
</style>

<script>
const thumbs=document.querySelectorAll('.thumb');
const mainImage=document.getElementById('mainImage');

thumbs.forEach(thumb=>{
  thumb.addEventListener('click',()=>{
    thumbs.forEach(t=>t.classList.remove('active'));
    thumb.classList.add('active');
    mainImage.src=thumb.querySelector('img').src;
  });
});
</script>

</ProductLayout>
