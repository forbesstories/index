---
// src/pages/product/index.astro

import ProductLayout from '../../layouts/ProductLayout.astro';

const products = [
  {
    slug: 'american-eagle-tshirt',
    title: 'American Eagle T-Shirt',
    price: '$16',
    oldPrice: '$24',
    image:
      'https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=1200&auto=format&fit=crop'
  },

  {
    slug: 'cyber-eagle-shirt',
    title: 'Cyber Eagle Shirt',
    price: '$18',
    oldPrice: '$28',
    image:
      'https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?q=80&w=1200&auto=format&fit=crop'
  },

  {
    slug: 'retro-freedom-tee',
    title: 'Retro Freedom Tee',
    price: '$20',
    oldPrice: '$30',
    image:
      'https://images.unsplash.com/photo-1512436991641-6745cdb1723f?q=80&w=1200&auto=format&fit=crop'
  },

  {
    slug: 'anime-vintage-shirt',
    title: 'Anime Vintage Shirt',
    price: '$17',
    oldPrice: '$26',
    image:
      'https://images.unsplash.com/photo-1523381210434-271e8be1f52b?q=80&w=1200&auto=format&fit=crop'
  }
];
---

<ProductLayout
  title="Products | AI PRINT"
  description="Browse premium POD products built with Astro."
>

<section class="hero">
  <div class="hero-content">
    <span class="badge">
      PREMIUM POD MARKETPLACE
    </span>

    <h1>
      Discover Modern
      <br />
      Print-On-Demand Designs
    </h1>

    <p>
      Ultra fast Astro ecommerce storefront with modern UX,
      responsive layouts, and SEO optimized architecture.
    </p>
  </div>
</section>

<section class="products-section">

  <div class="section-head">
    <h2>Trending Products</h2>

    <div class="filters">
      <button class="active">
        Trending
      </button>

      <button>
        Latest
      </button>

      <button>
        Best Seller
      </button>
    </div>
  </div>

  <div class="grid">

    {
      products.map(product => (
        <a
          href={`/product/${product.slug}`}
          class="card"
        >
          <div class="card-image">
            <img
              src={product.image}
              alt={product.title}
              loading="lazy"
            />
          </div>

          <div class="card-body">

            <div class="card-top">
              <span class="tag">
                TRENDING
              </span>
            </div>

            <h3>
              {product.title}
            </h3>

            <div class="price-wrap">
              <span class="price">
                {product.price}
              </span>

              <span class="old-price">
                {product.oldPrice}
              </span>
            </div>

          </div>
        </a>
      ))
    }

  </div>

</section>

<style>
.hero{
  background:
    linear-gradient(
      135deg,
      #111827,
      #1e293b
    );

  color:#fff;

  border-radius:40px;

  padding:90px 50px;

  margin-bottom:50px;

  overflow:hidden;

  position:relative;
}

.hero::before{
  content:"";

  position:absolute;

  inset:0;

  background:
    radial-gradient(
      circle at top right,
      rgba(88,101,242,.35),
      transparent 35%
    );
}

.hero-content{
  position:relative;
  z-index:2;
  max-width:700px;
}

.badge{
  display:inline-flex;

  background:
    rgba(255,255,255,.12);

  border:
    1px solid rgba(255,255,255,.15);

  padding:10px 16px;

  border-radius:999px;

  font-size:13px;

  font-weight:800;

  letter-spacing:.5px;

  margin-bottom:20px;
}

.hero h1{
  font-size:68px;

  line-height:1;

  margin-bottom:24px;
}

.hero p{
  font-size:18px;

  line-height:1.8;

  color:#d1d5db;
}

.products-section{
  margin-top:30px;
}

.section-head{
  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:20px;

  margin-bottom:30px;
}

.section-head h2{
  font-size:42px;
}

.filters{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

.filters button{
  border:none;

  background:#fff;

  padding:12px 18px;

  border-radius:14px;

  font-weight:700;

  cursor:pointer;

  box-shadow:var(--shadow);
}

.filters .active{
  background:var(--dark);
  color:#fff;
}

.grid{
  display:grid;

  grid-template-columns:
    repeat(4,1fr);

  gap:24px;
}

.card{
  background:#fff;

  border-radius:30px;

  overflow:hidden;

  box-shadow:var(--shadow);

  transition:.25s;
}

.card:hover{
  transform:
    translateY(-6px);
}

.card-image{
  overflow:hidden;
}

.card-image img{
  width:100%;

  height:360px;

  object-fit:cover;

  transition:.4s;
}

.card:hover img{
  transform:scale(1.05);
}

.card-body{
  padding:22px;
}

.card-top{
  margin-bottom:12px;
}

.tag{
  display:inline-flex;

  background:#eef2ff;

  color:#4338ca;

  padding:8px 12px;

  border-radius:999px;

  font-size:12px;

  font-weight:800;
}

.card h3{
  font-size:22px;

  line-height:1.3;

  margin-bottom:16px;
}

.price-wrap{
  display:flex;

  align-items:center;

  gap:12px;
}

.price{
  font-size:28px;

  font-weight:900;
}

.old-price{
  color:#999;

  text-decoration:line-through;
}

@media(max-width:1200px){
  .grid{
    grid-template-columns:
      repeat(2,1fr);
  }

  .hero h1{
    font-size:54px;
  }
}

@media(max-width:768px){

  .hero{
    padding:60px 24px;
  }

  .hero h1{
    font-size:40px;
  }

  .hero p{
    font-size:16px;
  }

  .section-head{
    flex-direction:column;
    align-items:flex-start;
  }

  .section-head h2{
    font-size:34px;
  }

  .grid{
    grid-template-columns:1fr;
  }

  .card-image img{
    height:320px;
  }
}
</style>
