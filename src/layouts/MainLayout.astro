---
import "../styles/global.css";

import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { generateFaqSchema } from "../lib/faq-schema";
import { homeSchema } from "../lib/home-schema";

const {
  title,
  description,
  canonical,
  html = "",
  articleSchema,
  breadcrumbs,
  amp,
  slug,
  isHome = false
} = Astro.props;

const pathname = Astro.url.pathname;


/* =====================================
   AUTO BREADCRUMBS
===================================== */

const autoBreadcrumbs =
  breadcrumbs ??
  (pathname.startsWith("/tools")
    ? (() => {

        const parts = pathname
          .split("/")
          .filter(Boolean);

        const items = [
          {
            name: "Home",
            url: "/"
          }
        ];

        let path = "";

        for (const part of parts) {

          path += `/${part}`;

          items.push({
            name: part
              .replace(/-/g, " ")
              .replace(/\b\w/g, (c) => c.toUpperCase()),
            url: path
          });

        }

        return items;

      })()
    : breadcrumbs);


/* =====================================
   FAQ SCHEMA
===================================== */

const faqSchema = generateFaqSchema(html);
---

<!doctype html>

<html lang="id">

<head>

  <SeoHead
    title={title}
    description={description}
    canonical={canonical}
    articleSchema={articleSchema}
    breadcrumbs={autoBreadcrumbs}
    faqSchema={faqSchema}
    amp={amp}
    slug={slug}
    isHome={isHome}
  />


  {
    isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(homeSchema)}
      />
    )
  }


  <!-- =================================
       THEME INITIALIZATION
  ================================== -->

  <script is:inline>
    (() => {

      const savedTheme =
        localStorage.getItem("theme");

      const systemTheme =
        window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches
          ? "dark"
          : "light";

      document.documentElement.dataset.theme =
        savedTheme || systemTheme;

    })();
  </script>

</head>


<body>

  <Header />


  <main>

    {
      pathname.startsWith("/tools") &&
      autoBreadcrumbs &&
      autoBreadcrumbs.length > 1 && (

        <nav
          class="breadcrumb"
          aria-label="Breadcrumb"
        >

          {
            autoBreadcrumbs.map((item, index) => (
              <>

                {index > 0 && (
                  <span class="separator">
                    /
                  </span>
                )}

                {
                  index === autoBreadcrumbs.length - 1 ? (

                    <span>
                      {item.name}
                    </span>

                  ) : (

                    <a href={item.url}>
                      {item.name}
                    </a>

                  )
                }

              </>
            ))
          }

        </nav>

      )
    }


    <slot />

  </main>


  <Footer />


</body>

</html>
