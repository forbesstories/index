---
import "../styles/global.css";

import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { generateFaqSchema } from "../lib/faq-schema";
import { homeSchema } from "../lib/home-schema";

const {
  title,
  description,
  canonical,
  html = "",
  articleSchema,
  breadcrumbs = null,
  amp,
  slug,
  isHome = false
} = Astro.props;

const faqSchema = generateFaqSchema(html);
---

<!doctype html>

<html lang="id">

<head>

  <SeoHead
    title={title}
    description={description}
    canonical={canonical}
    articleSchema={articleSchema}
    breadcrumbs={breadcrumbs}
    faqSchema={faqSchema}
    amp={amp}
    slug={slug}
    isHome={isHome}
  />

  {
    isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(homeSchema)}
      />
    )
  }

  <!-- THEME INITIALIZATION -->

  <script is:inline>
    (() => {

      const savedTheme =
        localStorage.getItem("theme");

      const systemTheme =
        window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches
          ? "dark"
          : "light";

      document.documentElement.dataset.theme =
        savedTheme || systemTheme;

    })();
  </script>

</head>

<body>

  <Header />

  <main>
    <slot />
  </main>

  <Footer />

  <script is:inline>
    const html = document.documentElement;

    const themeToggle =
      document.getElementById("themeToggle");

    const mediaQuery =
      window.matchMedia(
        "(prefers-color-scheme: dark)"
      );

    if (themeToggle) {
      themeToggle.onclick = () => {

        const nextTheme =
          html.dataset.theme === "dark"
            ? "light"
            : "dark";

        html.dataset.theme = nextTheme;

        localStorage.setItem(
          "theme",
          nextTheme
        );

      };
    }

    mediaQuery.addEventListener(
      "change",
      event => {

        const savedTheme =
          localStorage.getItem("theme");

        if (!savedTheme) {

          html.dataset.theme =
            event.matches
              ? "dark"
              : "light";

        }

      }
    );


    const menu =
      document.getElementById("menuToggle");

    const nav =
      document.getElementById("nav");

    if (menu && nav) {

      menu.onclick = () => {

        nav.classList.toggle("active");

        menu.textContent =
          nav.classList.contains("active")
            ? "✕"
            : "☰";

      };

      document
        .querySelectorAll(".nav a")
        .forEach(link => {

          link.onclick = () => {

            nav.classList.remove("active");

            menu.textContent = "☰";

          };

        });

    }


    document
      .querySelectorAll(".drop-btn")
      .forEach(btn => {

        btn.onclick = e => {

          if (window.innerWidth > 768) {
            return;
          }

          e.preventDefault();

          btn.parentElement.classList.toggle(
            "open"
          );

        };

      });
  </script>

</body>

</html>
