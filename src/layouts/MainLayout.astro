---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { generateFaqSchema } from "../lib/faq-schema";
import { homeSchema } from "../lib/home-schema";

const {
  title,
  description,
  canonical,
  html = "",
  articleSchema,
  breadcrumbs,
  amp,
  slug,
  isHome = false,
pageCSS = []
} = Astro.props;

const autoPageCSS = [...pageCSS];

const pathname = Astro.url.pathname;

if (pathname.startsWith("/tools") && !autoPageCSS.includes("tools")) {
  autoPageCSS.push("tools");
}



const autoBreadcrumbs =
  breadcrumbs ??
  (Astro.url.pathname.startsWith("/tools")
    ? (() => {
        const parts = Astro.url.pathname
          .split("/")
          .filter(Boolean);

        const items = [
          {
            name: "Home",
            url: "/",
          },
        ];

        let path = "";

        for (const part of parts) {
          path += `/${part}`;

          items.push({
            name: part
              .replace(/-/g, " ")
              .replace(/\b\w/g, c => c.toUpperCase()),
            url: path,
          });
        }

        return items;
      })()
    : breadcrumbs);


const faqSchema = generateFaqSchema(html);
---

<!doctype html>
<html lang="id">
<head>
  <SeoHead
  title={title}
  description={description}
  canonical={canonical}
  articleSchema={articleSchema}
  breadcrumbs={autoBreadcrumbs}
  faqSchema={faqSchema}
  amp={amp}
  slug={slug}
  isHome={isHome}
/>

{autoPageCSS.map(css => (
  <link rel="stylesheet" href={`/styles/${css}.css`}>
))}

{isHome && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(homeSchema)}
  />
)}



<script is:inline>
  if (localStorage.getItem("theme") === "light") {
    document.documentElement.classList.add("light-mode");
  }
</script>
</head>

<body>

  <Header />

  <main>

{Astro.url.pathname.startsWith("/tools") &&
  autoBreadcrumbs &&
  autoBreadcrumbs.length > 1 && (
  <nav class="breadcrumb" aria-label="Breadcrumb">
    {autoBreadcrumbs.map((item, index) => (
      <>
        {index > 0 && <span class="separator">/</span>}
        {index === autoBreadcrumbs.length - 1 ? (
          <span>{item.name}</span>
        ) : (
          <a href={item.url}>{item.name}</a>
        )}
      </>
    ))}
  </nav>
)}


    <slot />
  </main>

  <Footer />

<script is:inline>

const html = document.documentElement;

const themeBtn =
  document.getElementById("themeToggle");

/* LOAD */

if(localStorage.getItem("theme")==="light"){
  html.classList.add("light-mode");
}

/* TOGGLE */

themeBtn?.addEventListener("click",()=>{

  html.classList.toggle("light-mode");

  localStorage.setItem(
    "theme",
    html.classList.contains("light-mode")
      ? "light"
      : "dark"
  );

});

</script>

<script is:inline>

function openMenu(){
  document
    .getElementById("mobileMenu")
    .classList.add("active");
}

function closeMenu(){
  document
    .getElementById("mobileMenu")
    .classList.remove("active");
}


/* FAQ */

const faqItems =
  document.querySelectorAll(".faq-item");

faqItems.forEach(item=>{

  item
    .querySelector(".faq-question")
    .addEventListener("click",()=>{

      item.classList.toggle("active");

    });

});

</script>

</body>
</html>
