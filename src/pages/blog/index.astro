---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/blog.css";

import { SITE } from "../../lib/site";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

/* =====================================
   SORT ARTICLES
===================================== */

const sortedPosts = [...posts].sort(
  (a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
);

/* =====================================
   SEO
===================================== */

const pageTitle =
  "Blog AI Mr Ferdy | AI, SEO, Teknologi & Digital";

const pageDescription =
  "Baca artikel AI Mr Ferdy tentang kecerdasan buatan, SEO, teknologi, otomasi, pembuatan konten, dan perkembangan dunia digital.";
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url("/blog/")}
>

  <!-- =====================================
       BLOG HERO
  ===================================== -->

  <section class="blog-hero">

    <div class="container-page">

      <div class="blog-hero-content">

        <span class="hero-badge">
          AI MR FERDY BLOG
        </span>

        <h1>
          AI, Teknologi & Dunia Digital
        </h1>

        <p>
          Temukan pembahasan seputar kecerdasan buatan,
          SEO, otomasi, teknologi web, pembuatan konten,
          dan berbagai perkembangan digital yang relevan
          untuk kebutuhan masa kini.
        </p>

      </div>

    </div>

  </section>


  <!-- =====================================
       ARTICLE LIST
  ===================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <h2 class="section-title">
          Artikel Terbaru
        </h2>

        <p class="section-desc">
          Jelajahi artikel dan panduan terbaru mengenai AI,
          SEO, teknologi, otomasi, serta berbagai topik
          digital lainnya.
        </p>

      </div>


      {
        sortedPosts.length > 0 ? (

          <div class="blog-grid">

            {
              sortedPosts.map((post) => (

                <article class="blog-card">

                  <a
                    href={`/blog/${post.slug}/`}
                    class="blog-card-link"
                  >

                    <!-- IMAGE -->

                    <div class="blog-card-image">

                      <img
                        src={SITE.url(
                          `/api/og/${post.slug}.svg`
                        )}
                        alt={`${post.data.title} - AI Mr Ferdy`}
                        loading="lazy"
                        width="1200"
                        height="630"
                      />

                    </div>


                    <!-- CONTENT -->

                    <div class="blog-card-content">

                      <div class="blog-card-meta">

                        <time
                          datetime={new Date(
                            post.data.date
                          ).toISOString()}
                        >
                          {
                            new Date(
                              post.data.date
                            ).toLocaleDateString(
                              "id-ID",
                              {
                                day: "numeric",
                                month: "long",
                                year: "numeric"
                              }
                            )
                          }
                        </time>

                      </div>


                      <h3>
                        {post.data.title}
                      </h3>


                      {
                        post.data.description && (

                          <p>
                            {post.data.description}
                          </p>

                        )
                      }


                      <span class="readmore">
                        Baca Artikel →
                      </span>

                    </div>

                  </a>

                </article>

              ))
            }

          </div>

        ) : (

          <!-- EMPTY STATE -->

          <div class="content-card blog-empty">

            <h2>
              Belum Ada Artikel
            </h2>

            <p>
              Belum ada artikel yang tersedia saat ini.
              Silakan kembali lagi untuk menemukan
              pembahasan terbaru dari AI Mr Ferdy.
            </p>

          </div>

        )
      }

    </div>

  </section>


  <!-- =====================================
       ABOUT BLOG
  ===================================== -->

  <section class="section">

    <div class="container-page">

      <div class="content-card blog-information">

        <h2>
          Tentang Blog AI Mr Ferdy
        </h2>

        <p>
          Blog AI Mr Ferdy menjadi ruang untuk membahas
          perkembangan kecerdasan buatan, teknologi web,
          SEO, otomasi, dan berbagai topik digital lainnya.
          Konten disusun untuk membantu pembaca memahami
          teknologi dengan cara yang lebih sederhana dan
          mudah diterapkan.
        </p>

        <p>
          Selain membahas perkembangan teknologi, artikel
          di dalam blog juga dapat berisi panduan, tips,
          penjelasan tools, serta wawasan praktis yang
          berkaitan dengan aktivitas digital sehari-hari.
        </p>

      </div>

    </div>

  </section>


  <!-- =====================================
       CTA
  ===================================== -->

  <section class="cta">

    <div class="container-page">

      <div class="cta-content">

        <h2>
          Jelajahi AI Tools AI Mr Ferdy
        </h2>

        <p>
          Selain membaca artikel, Anda juga dapat mencoba
          berbagai tools digital yang tersedia untuk
          membantu pekerjaan menjadi lebih praktis.
        </p>

        <a
          href="/tools/"
          class="btn btn-primary"
        >
          Lihat AI Tools
        </a>

      </div>

    </div>

  </section>

</MainLayout>
