---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

/*
|--------------------------------------------------------------------------
| BLOG
|--------------------------------------------------------------------------
*/

const posts = await getCollection("blog");

/*
|--------------------------------------------------------------------------
| PRODUCT
|--------------------------------------------------------------------------
*/

const products = await getCollection("product");

/*
|--------------------------------------------------------------------------
| TOOLS
|--------------------------------------------------------------------------
|
| Semua tool sekarang berada di:
|
| src/pages/tools/**/*.astro
|
| Jadi TIDAK menggunakan:
|
| src/content/tools/*.md
|
|--------------------------------------------------------------------------
*/

const toolModules = import.meta.glob(
  "./tools/**/*.astro",
  {
    eager: true,
    query: "?raw",
    import: "default",
  }
);


/*
|--------------------------------------------------------------------------
| BUILD TOOL SEARCH INDEX
|--------------------------------------------------------------------------
*/

const tools = Object.keys(toolModules)
  .map((filePath) => {

    /*
     * Hapus prefix ./tools/
     */

    const relativePath =
      filePath
        .replace(/^\.\/tools\//, "")
        .replace(/\.astro$/, "");


    /*
     * Hapus index dari URL
     *
     * ./tools/web/cssminify/index.astro
     *
     * menjadi:
     *
     * web/cssminify
     */

    const cleanPath =
      relativePath
        .replace(/\/index$/, "");


    /*
     * URL
     */

    const href =
      `/tools/${cleanPath}/`;


    /*
     * Ambil nama file / folder terakhir
     */

    const slug =
      cleanPath
        .split("/")
        .filter(Boolean)
        .pop() || "tool";


    /*
     * Ubah slug menjadi title
     *
     * cssminify
     * =>
     * CSS Minify
     *
     * audio-converter
     * =>
     * Audio Converter
     */

    const title =
      slug
        .replace(/[-_]+/g, " ")
        .replace(/\b\w/g, (char) =>
          char.toUpperCase()
        );


    /*
     * Category berdasarkan folder pertama
     */

    const parts =
      cleanPath
        .split("/")
        .filter(Boolean);


    const category =
      parts.length > 1
        ? parts[0]
        : "Tools";


    /*
     * Search keywords
     */

    const keywords =
      [
        title,
        slug,
        cleanPath,
        category,
      ]
        .join(" ")
        .toLowerCase();


    return {

      title,

      description:
        `Online ${title} tool untuk membantu kebutuhan Anda.`,

      href,

      category,

      keywords,

    };

  })
  .sort(
    (a, b) =>
      a.title.localeCompare(
        b.title
      )
  );


/*
|--------------------------------------------------------------------------
| SEARCH DATA
|--------------------------------------------------------------------------
*/

const searchData = [

  /*
   * BLOG
   */

  ...posts.map((post) => ({

    type: "blog",

    title:
      post.data.title,

    description:
      post.data.description || "",

    href:
      `/blog/${post.slug}/`,

    category:
      "Blog",

    keywords:
      [
        post.data.title,
        post.data.description || "",
        post.slug,
      ]
        .join(" ")
        .toLowerCase(),

  })),


  /*
   * TOOLS
   */

  ...tools.map((tool) => ({

    type: "tool",

    title:
      tool.title,

    description:
      tool.description,

    href:
      tool.href,

    category:
      tool.category,

    keywords:
      tool.keywords,

  })),


  /*
   * PRODUCTS
   */

  ...products.map((product) => ({

    type: "product",

    title:
      product.data.title,

    description:
      product.data.description || "",

    href:
      `/product/${product.slug}/`,

    category:
      "Product",

    keywords:
      [
        product.data.title,
        product.data.description || "",
        product.slug,
      ]
        .join(" ")
        .toLowerCase(),

  })),

];
---

<MainLayout
  title="Search | AI Mr Ferdy"
  description="Cari artikel, tools, dan produk AI Mr Ferdy."
  canonical="/search/"
>

  <main class="search-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="search-header">

      <span class="search-label">
        SEARCH
      </span>

      <h1>
        Search AI Mr Ferdy
      </h1>

      <p>
        Cari artikel, tools, atau produk dengan cepat.
      </p>

    </header>


    <!-- =====================================================
         SEARCH FORM
    ====================================================== -->

    <form
      id="searchForm"
      class="search-form"
    >

      <div class="search-input-wrap">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="7"
          />

          <path
            d="m20 20-4-4"
          />

        </svg>


        <input
          id="searchInput"
          type="search"
          name="q"
          placeholder="Cari Audio, CSS Minify, AI..."
          autocomplete="off"
        />

      </div>


      <select
        id="typeFilter"
        aria-label="Filter tipe"
      >

        <option value="all">
          Semua
        </option>

        <option value="blog">
          Blog
        </option>

        <option value="tool">
          Tools
        </option>

        <option value="product">
          Product
        </option>

      </select>


      <button
        type="submit"
        class="search-btn"
      >
        Search
      </button>

    </form>


    <!-- =====================================================
         RESULT INFO
    ====================================================== -->

    <div
      id="resultInfo"
      class="result-info"
      hidden
    ></div>


    <!-- =====================================================
         EMPTY STATE
    ====================================================== -->

    <div
      id="emptyState"
      class="empty-state"
    >

      <div class="empty-icon">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="7"
          />

          <path
            d="m20 20-4-4"
          />

        </svg>

      </div>

      <h2>
        Cari sesuatu
      </h2>

      <p>
        Masukkan kata kunci untuk mencari
        artikel, tools, atau produk.
      </p>

    </div>


    <!-- =====================================================
         RESULTS
    ====================================================== -->

    <div
      id="results"
      class="results"
    ></div>


  </main>

</MainLayout>


<script define:vars={{ searchData }}>

  /*
  |--------------------------------------------------------------------------
  | ELEMENTS
  |--------------------------------------------------------------------------
  */

  const form =
    document.querySelector(
      "#searchForm"
    );


  const input =
    document.querySelector(
      "#searchInput"
    );


  const filter =
    document.querySelector(
      "#typeFilter"
    );


  const results =
    document.querySelector(
      "#results"
    );


  const emptyState =
    document.querySelector(
      "#emptyState"
    );


  const resultInfo =
    document.querySelector(
      "#resultInfo"
    );


  /*
  |--------------------------------------------------------------------------
  | SEARCH DATA
  |--------------------------------------------------------------------------
  */

  const data =
    Array.isArray(searchData)
      ? searchData
      : [];


  /*
  |--------------------------------------------------------------------------
  | ESCAPE HTML
  |--------------------------------------------------------------------------
  */

  function escapeHtml(value){

    return String(value ?? "")
      .replace(
        /&/g,
        "&amp;"
      )
      .replace(
        /</g,
        "&lt;"
      )
      .replace(
        />/g,
        "&gt;"
      )
      .replace(
        /"/g,
        "&quot;"
      )
      .replace(
        /'/g,
        "&#039;"
      );

  }


  /*
  |--------------------------------------------------------------------------
  | SEARCH
  |--------------------------------------------------------------------------
  */

  function runSearch(){

    const keyword =
      input.value
        .trim()
        .toLowerCase();


    const selectedType =
      filter.value;


    /*
     * Tidak ada keyword
     */

    if(!keyword){

      results.innerHTML = "";

      resultInfo.hidden = true;

      emptyState.style.display =
        "block";

      emptyState.innerHTML = `

        <div class="empty-icon">

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >

            <circle
              cx="11"
              cy="11"
              r="7"
            />

            <path
              d="m20 20-4-4"
            />

          </svg>

        </div>

        <h2>
          Cari sesuatu
        </h2>

        <p>
          Masukkan kata kunci untuk mencari
          artikel, tools, atau produk.
        </p>

      `;

      return;

    }


    /*
     * FILTER
     */

    const filtered =
      data.filter(
        (item) => {

          const typeMatch =
            selectedType === "all" ||
            item.type === selectedType;


          const searchable =
            [
              item.title,
              item.description,
              item.category,
              item.keywords,
              item.href,
            ]
              .join(" ")
              .toLowerCase();


          const keywordMatch =
            searchable.includes(
              keyword
            );


          return (
            typeMatch &&
            keywordMatch
          );

        }
      );


    /*
     * EMPTY RESULT
     */

    if(!filtered.length){

      results.innerHTML = "";

      emptyState.style.display =
        "block";

      emptyState.innerHTML = `

        <div class="empty-icon">

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >

            <circle
              cx="11"
              cy="11"
              r="7"
            />

            <path
              d="m20 20-4-4"
            />

          </svg>

        </div>

        <h2>
          Tidak ada hasil ditemukan
        </h2>

        <p>
          Tidak ditemukan hasil untuk
          "<strong>${escapeHtml(keyword)}</strong>".
        </p>

      `;

      resultInfo.hidden = true;

      return;

    }


    /*
     * HAS RESULTS
     */

    emptyState.style.display =
      "none";


    resultInfo.hidden =
      false;


    resultInfo.textContent =
      `${filtered.length} hasil ditemukan`;


    /*
     * RENDER
     */

    results.innerHTML =
      filtered
        .map(
          (item) => `

            <a
              class="search-item"
              href="${escapeHtml(item.href)}"
            >

              <div class="search-item-top">

                <span
                  class="badge badge-${escapeHtml(item.type)}"
                >
                  ${escapeHtml(item.type)}
                </span>

                <span class="category">
                  ${escapeHtml(item.category)}
                </span>

              </div>


              <h2>
                ${escapeHtml(item.title)}
              </h2>


              <p>
                ${escapeHtml(item.description)}
              </p>


              <span class="search-url">
                ${escapeHtml(item.href)}
              </span>

            </a>

          `
        )
        .join("");

  }


  /*
  |--------------------------------------------------------------------------
  | URL
  |--------------------------------------------------------------------------
  */

  function loadFromUrl(){

    const params =
      new URLSearchParams(
        window.location.search
      );


    const query =
      params.get("q") || "";


    const type =
      params.get("type") || "all";


    input.value =
      query;


    if(
      [
        "all",
        "blog",
        "tool",
        "product",
      ].includes(type)
    ){

      filter.value =
        type;

    }else{

      filter.value =
        "all";

    }


    if(query.trim()){

      runSearch();

    }

  }


  /*
  |--------------------------------------------------------------------------
  | SUBMIT
  |--------------------------------------------------------------------------
  */

  form.addEventListener(
    "submit",
    (event) => {

      event.preventDefault();


      const query =
        input.value.trim();


      const type =
        filter.value;


      const params =
        new URLSearchParams();


      if(query){

        params.set(
          "q",
          query
        );

      }


      if(
        type &&
        type !== "all"
      ){

        params.set(
          "type",
          type
        );

      }


      const queryString =
        params.toString();


      const url =
        queryString
          ? `${window.location.pathname}?${queryString}`
          : window.location.pathname;


      history.replaceState(
        {},
        "",
        url
      );


      runSearch();

    }
  );


  /*
  |--------------------------------------------------------------------------
  | FILTER CHANGE
  |--------------------------------------------------------------------------
  */

  filter.addEventListener(
    "change",
    () => {

      if(
        input.value.trim()
      ){

        runSearch();

      }

    }
  );


  /*
  |--------------------------------------------------------------------------
  | INITIAL
  |--------------------------------------------------------------------------
  */

  loadFromUrl();

</script>


<style is:global>

/* =========================================================
   PAGE
========================================================= */

.search-page{

  width:
    min(
      900px,
      calc(100% - 32px)
    );

  margin:
    0 auto;

  padding:
    60px 0 90px;

  color:
    var(--text);

}


/* =========================================================
   HEADER
========================================================= */

.search-header{

  margin-bottom:
    30px;

}


.search-label{

  display:
    inline-block;

  margin-bottom:
    8px;

  color:
    var(--primary);

  font-size:
    10px;

  font-weight:
    800;

  letter-spacing:
    1.6px;

}


.search-header h1{

  margin:
    0;

  font-size:
    clamp(
      30px,
      5vw,
      44px
    );

  line-height:
    1.15;

  letter-spacing:
    -1.2px;

}


.search-header p{

  margin:
    10px 0 0;

  color:
    var(--text-secondary);

  font-size:
    14px;

  line-height:
    1.7;

}


/* =========================================================
   FORM
========================================================= */

.search-form{

  display:
    grid;

  grid-template-columns:
    minmax(0, 1fr)
    160px
    110px;

  gap:
    10px;

  margin-bottom:
    20px;

}


.search-input-wrap{

  position:
    relative;

}


.search-input-wrap svg{

  position:
    absolute;

  top:
    50%;

  left:
    15px;

  width:
    18px;

  height:
    18px;

  transform:
    translateY(-50%);

  color:
    var(--text-secondary);

  pointer-events:
    none;

}


#searchInput,
#typeFilter{

  width:
    100%;

  box-sizing:
    border-box;

  height:
    48px;

  border:
    1px solid var(--border);

  border-radius:
    10px;

  outline:
    none;

  background:
    var(--surface);

  color:
    var(--text);

  font-family:
    inherit;

  font-size:
    13px;

}


#searchInput{

  padding:
    0 15px 0 45px;

}


#typeFilter{

  padding:
    0 12px;

}


#searchInput:focus,
#typeFilter:focus{

  border-color:
    var(--primary);

  box-shadow:
    0 0 0 3px
    color-mix(
      in srgb,
      var(--primary) 10%,
      transparent
    );

}


.search-btn{

  height:
    48px;

  border:
    0;

  border-radius:
    10px;

  background:
    var(--bgbtn);

  color:
    var(--textbtn);

  font-family:
    inherit;

  font-size:
    13px;

  font-weight:
    800;

  cursor:
    pointer;

  transition:
    transform .2s,
    filter .2s;

}


.search-btn:hover{

  transform:
    translateY(-1px);

  filter:
    brightness(1.08);

}


/* =========================================================
   RESULT INFO
========================================================= */

.result-info{

  margin:
    20px 0 12px;

  color:
    var(--text-secondary);

  font-size:
    12px;

  font-weight:
    600;

}


/* =========================================================
   RESULTS
========================================================= */

.results{

  display:
    grid;

  gap:
    12px;

}


.search-item{

  display:
    block;

  padding:
    20px;

  border:
    1px solid var(--border);

  border-radius:
    14px;

  background:
    var(--surface);

  color:
    var(--text);

  text-decoration:
    none;

  box-shadow:
    var(--shadow);

  transition:
    transform .2s,
    border-color .2s,
    box-shadow .2s;

}


.search-item:hover{

  transform:
    translateY(-2px);

  border-color:
    var(--primary);

}


.search-item-top{

  display:
    flex;

  align-items:
    center;

  gap:
    8px;

  margin-bottom:
    10px;

}


.badge{

  display:
    inline-flex;

  align-items:
    center;

  min-height:
    22px;

  padding:
    0 8px;

  border-radius:
    999px;

  background:
    color-mix(
      in srgb,
      var(--primary) 10%,
      transparent
    );

  color:
    var(--primary);

  font-size:
    9px;

  font-weight:
    800;

  text-transform:
    uppercase;

  letter-spacing:
    .5px;

}


.category{

  color:
    var(--text-secondary);

  font-size:
    10px;

}


.search-item h2{

  margin:
    0 0 7px;

  font-size:
    17px;

  line-height:
    1.4;

}


.search-item p{

  margin:
    0;

  color:
    var(--text-secondary);

  font-size:
    12px;

  line-height:
    1.7;

}


.search-url{

  display:
    block;

  margin-top:
    12px;

  color:
    var(--primary);

  font-size:
    10px;

  opacity:
    .8;

}


/* =========================================================
   EMPTY
========================================================= */

.empty-state{

  padding:
    55px 20px;

  text-align:
    center;

  border:
    1px dashed var(--border);

  border-radius:
    14px;

}


.empty-icon{

  width:
    54px;

  height:
    54px;

  margin:
    0 auto 15px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border-radius:
    50%;

  background:
    var(--surface-hover);

  color:
    var(--text-secondary);

}


.empty-icon svg{

  width:
    25px;

  height:
    25px;

}


.empty-state h2{

  margin:
    0;

  font-size:
    18px;

}


.empty-state p{

  max-width:
    500px;

  margin:
    8px auto 0;

  color:
    var(--text-secondary);

  font-size:
    12px;

  line-height:
    1.7;

}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:700px){

  .search-page{

    width:
      calc(100% - 20px);

    padding:
      35px 0 60px;

  }


  .search-form{

    grid-template-columns:
      1fr;

  }


  .search-btn{

    width:
      100%;

  }


  .search-item{

    padding:
      17px;

  }

}

</style>
