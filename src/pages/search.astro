import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";


/* =========================================================
   CONTENT COLLECTION
========================================================= */

const posts =
  await getCollection("blog");

const products =
  await getCollection("product");


/* =========================================================
   TOOLS
   Semua halaman:

   src/pages/tools/**/*.astro

   Dibaca sebagai RAW SOURCE.
========================================================= */

const toolFiles =
  import.meta.glob(
    "./tools/**/*.astro",
    {
      eager: true,
      query: "?raw",
      import: "default"
    }
  );


/* =========================================================
   CLEAN TEXT
========================================================= */

function cleanText(value) {

  return String(value || "")
    .replace(
      /\\n/g,
      " "
    )
    .replace(
      /\s+/g,
      " "
    )
    .trim();

}


/* =========================================================
   TITLE DARI FILE NAME
========================================================= */

function titleFromFilename(filename) {

  return String(filename || "")
    .replace(
      /\.astro$/i,
      ""
    )
    .replace(
      /[-_]+/g,
      " "
    )
    .replace(
      /([a-z])([A-Z])/g,
      "$1 $2"
    )
    .replace(
      /\s+/g,
      " "
    )
    .trim()
    .replace(
      /\b\w/g,
      char =>
        char.toUpperCase()
    );

}


/* =========================================================
   CATEGORY DARI PATH
========================================================= */

function categoryFromPath(path) {

  const relative =
    path
      .replace(
        /^\.\/tools\//,
        ""
      )
      .replace(
        /\.astro$/,
        ""
      );

  const parts =
    relative.split("/");


  if (
    parts.length < 2
  ) {

    return "Tools";

  }


  return parts[0]
    .replace(
      /[-_]+/g,
      " "
    )
    .replace(
      /\b\w/g,
      char =>
        char.toUpperCase()
    );

}


/* =========================================================
   PARSE TOOL
========================================================= */

function parseTool(
  filePath,
  source
) {

  const raw =
    String(source || "");


  /* =======================================================
     RELATIVE PATH
  ======================================================= */

  const relativePath =
    filePath
      .replace(
        /^\.\/tools\//,
        ""
      )
      .replace(
        /\.astro$/,
        ""
      );


  /* =======================================================
     FILE NAME
  ======================================================= */

  const filename =
    relativePath
      .split("/")
      .pop() || "";


  /* =======================================================
     URL
  ======================================================= */

  const href =
    `/tools/${relativePath}/`;


  /* =======================================================
     TITLE
  ======================================================= */

  let title = "";


  /*
   * title="..."
   */

  const titleMatch =
    raw.match(
      /(?:^|\s)title\s*=\s*["']([^"']+)["']/
    );


  if (titleMatch) {

    title =
      cleanText(
        titleMatch[1]
      );

  }


  /*
   * const title = "..."
   */

  if (!title) {

    const constTitleMatch =
      raw.match(
        /(?:const|let|var)\s+title\s*=\s*["']([^"']+)["']/
      );


    if (constTitleMatch) {

      title =
        cleanText(
          constTitleMatch[1]
        );

    }

  }


  /*
   * title: "..."
   */

  if (!title) {

    const objectTitleMatch =
      raw.match(
        /(?:^|\n)\s*title\s*:\s*["']([^"']+)["']/
      );


    if (objectTitleMatch) {

      title =
        cleanText(
          objectTitleMatch[1]
        );

    }

  }


  /*
   * FALLBACK
   */

  if (!title) {

    title =
      titleFromFilename(
        filename
      );

  }


  /* =======================================================
     DESCRIPTION
  ======================================================= */

  let description = "";


  /*
   * description="..."
   */

  const descriptionMatch =
    raw.match(
      /(?:^|\s)description\s*=\s*["']([^"']+)["']/
    );


  if (descriptionMatch) {

    description =
      cleanText(
        descriptionMatch[1]
      );

  }


  /*
   * const description = "..."
   */

  if (!description) {

    const constDescriptionMatch =
      raw.match(
        /(?:const|let|var)\s+description\s*=\s*["']([^"']+)["']/
      );


    if (
      constDescriptionMatch
    ) {

      description =
        cleanText(
          constDescriptionMatch[1]
        );

    }

  }


  /*
   * description: "..."
   */

  if (!description) {

    const objectDescriptionMatch =
      raw.match(
        /(?:^|\n)\s*description\s*:\s*["']([^"']+)["']/
      );


    if (
      objectDescriptionMatch
    ) {

      description =
        cleanText(
          objectDescriptionMatch[1]
        );

    }

  }


  /*
   * FALLBACK
   */

  if (!description) {

    description =
      `${title} online untuk membantu kebutuhan Anda.`;

  }


  /* =======================================================
     CATEGORY
  ======================================================= */

  const category =
    categoryFromPath(
      filePath
    );


  /* =======================================================
     SEARCH TEXT
  ======================================================= */

  /*
   * SELURUH SOURCE ikut dimasukkan.
   *
   * Jadi pencarian bisa menemukan keyword
   * yang ada di dalam source .astro.
   */

  const searchText =
    [
      title,
      description,
      category,
      relativePath,
      raw
    ]
      .join(" ")
      .toLowerCase();


  return {

    title,

    description,

    href,

    category,

    searchText

  };

}


/* =========================================================
   BUILD TOOLS
========================================================= */

const tools =
  Object.entries(
    toolFiles
  )

  .map(
    ([filePath, source]) =>
      parseTool(
        filePath,
        source
      )
  )

  /*
   * Jangan masukkan tools/index.astro
   */

  .filter(
    tool =>
      tool.href !==
      "/tools/index/"
  )

  /*
   * Pastikan title ada
   */

  .filter(
    tool =>
      tool.title
  )

  /*
   * Urutkan A-Z
   */

  .sort(
    (a, b) =>
      a.title.localeCompare(
        b.title,
        "id"
      )
  );

---


<MainLayout
  title="Search - AI Mr Ferdy"
  description="Cari artikel, tools, dan produk AI Mr Ferdy."
  canonical="/search/"
>

  <main class="search-page">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="search-header">

      <span class="search-label">
        SEARCH
      </span>

      <h1>
        Search AI Mr Ferdy
      </h1>

      <p>
        Cari artikel, tools, atau produk dengan cepat.
      </p>

    </header>


    <!-- =====================================================
         SEARCH FORM
    ====================================================== -->

    <form
      id="searchForm"
      class="search-form"
    >

      <div class="search-input-wrap">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="7"
          />

          <path
            d="m20 20-4-4"
          />

        </svg>


        <input
          id="searchInput"
          type="search"
          placeholder="Cari artikel, tools, atau produk..."
          autocomplete="off"
          aria-label="Cari"
        />

      </div>


      <select
        id="typeFilter"
        aria-label="Filter kategori"
      >

        <option value="all">
          Semua
        </option>

        <option value="blog">
          Blog
        </option>

        <option value="tool">
          Tools
        </option>

        <option value="product">
          Product
        </option>

      </select>


      <button
        type="submit"
        class="search-btn"
      >

        Search

      </button>

    </form>


    <!-- =====================================================
         RESULT INFO
    ====================================================== -->

    <div
      id="resultInfo"
      class="result-info"
    >
      Ketik kata kunci untuk mencari.
    </div>


    <!-- =====================================================
         EMPTY STATE
    ====================================================== -->

    <div
      id="emptyState"
      class="empty-state"
    >

      <div class="empty-icon">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >

          <circle
            cx="11"
            cy="11"
            r="7"
          />

          <path
            d="m20 20-4-4"
          />

        </svg>

      </div>


      <h2>
        Cari sesuatu
      </h2>


      <p>
        Masukkan kata kunci untuk mencari
        artikel, tools, atau produk.
      </p>

    </div>


    <!-- =====================================================
         RESULTS
         SEMUA ITEM DEFAULT TERSEMBUNYI MELALUI CSS
    ====================================================== -->

    <div
      id="results"
      class="results"
      aria-live="polite"
    >


      <!-- ===================================================
           BLOG
      ==================================================== -->

      {
        posts.map(
          (post) => (

            <a
              class="item search-item"
              data-type="blog"
              data-search={`
                ${post.data.title}
                ${post.data.description || ""}
                blog
                artikel
              `}
              href={`/blog/${post.slug}/`}
            >

              <span class="badge">
                Blog
              </span>

              <h2>
                {post.data.title}
              </h2>

              <p>
                {post.data.description}
              </p>

            </a>

          )
        )
      }


      <!-- ===================================================
           TOOLS
      ==================================================== -->

      {
        tools.map(
          (tool) => (

            <a
              class="item search-item"
              data-type="tool"
              data-search={tool.searchText}
              href={tool.href}
            >

              <span class="badge">
                {tool.category}
              </span>

              <h2>
                {tool.title}
              </h2>

              <p>
                {tool.description}
              </p>

            </a>

          )
        )
      }


      <!-- ===================================================
           PRODUCTS
      ==================================================== -->

      {
        products.map(
          (product) => (

            <a
              class="item search-item"
              data-type="product"
              data-search={`
                ${product.data.title}
                ${product.data.description || ""}
                product
                produk
              `}
              href={`/product/${product.slug}/`}
            >

              <span class="badge">
                Product
              </span>

              <h2>
                {product.data.title}
              </h2>

              <p>
                {product.data.description}
              </p>

            </a>

          )
        )
      }

    </div>

  </main>

</MainLayout>


<script is:inline>

/* =========================================================
   ELEMENTS
========================================================= */

const form =
  document.getElementById(
    "searchForm"
  );

const input =
  document.getElementById(
    "searchInput"
  );

const filter =
  document.getElementById(
    "typeFilter"
  );

const items =
  document.querySelectorAll(
    ".search-item"
  );

const emptyState =
  document.getElementById(
    "emptyState"
  );

const resultInfo =
  document.getElementById(
    "resultInfo"
  );


/* =========================================================
   SHOW EMPTY STATE
========================================================= */

function showEmpty(
  title,
  description
) {

  emptyState.style.display =
    "block";


  emptyState.innerHTML = `

    <div class="empty-icon">

      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >

        <circle
          cx="11"
          cy="11"
          r="7"
        />

        <path
          d="m20 20-4-4"
        />

      </svg>

    </div>

    <h2>
      ${title}
    </h2>

    <p>
      ${description}
    </p>

  `;

}


/* =========================================================
   RUN SEARCH
========================================================= */

function runSearch() {

  const keyword =
    input.value
      .trim()
      .toLowerCase();


  const selectedType =
    filter.value;


  let found = 0;


  /* =======================================================
     TIDAK ADA KEYWORD
  ======================================================= */

  if (!keyword) {

    items.forEach(
      (item) => {

        item.style.display =
          "none";

      }
    );


    resultInfo.textContent =
      "Ketik kata kunci untuk mencari.";


    showEmpty(
      "Cari sesuatu",
      "Masukkan kata kunci untuk mencari artikel, tools, atau produk."
    );


    return;

  }


  /* =======================================================
     SEARCH
  ======================================================= */

  items.forEach(
    (item) => {

      const text =
        (
          item.dataset.search ||
          ""
        )
          .toLowerCase();


      const itemType =
        item.dataset.type;


      const keywordMatch =
        text.includes(
          keyword
        );


      const typeMatch =
        selectedType === "all" ||
        itemType === selectedType;


      const shouldShow =
        keywordMatch &&
        typeMatch;


      item.style.display =
        shouldShow
          ? "block"
          : "none";


      if (shouldShow) {

        found++;

      }

    }
  );


  /* =======================================================
     ADA HASIL
  ======================================================= */

  if (found > 0) {

    emptyState.style.display =
      "none";


    resultInfo.textContent =
      `${found} hasil ditemukan.`;

    return;

  }


  /* =======================================================
     TIDAK ADA HASIL
  ======================================================= */

  resultInfo.textContent =
    "Tidak ada hasil ditemukan.";


  showEmpty(
    "Tidak ada hasil",
    "Coba gunakan kata kunci lain atau ubah kategori pencarian."
  );

}


/* =========================================================
   FORM SUBMIT
========================================================= */

form?.addEventListener(
  "submit",
  (event) => {

    event.preventDefault();


    const keyword =
      input.value.trim();


    const selectedType =
      filter.value;


    const params =
      new URLSearchParams();


    if (keyword) {

      params.set(
        "q",
        keyword
      );

    }


    if (
      selectedType &&
      selectedType !== "all"
    ) {

      params.set(
        "type",
        selectedType
      );

    }


    const queryString =
      params.toString();


    const newUrl =
      queryString
        ? `${window.location.pathname}?${queryString}`
        : window.location.pathname;


    history.replaceState(
      {},
      "",
      newUrl
    );


    runSearch();

  }
);


/* =========================================================
   FILTER CHANGE
========================================================= */

filter?.addEventListener(
  "change",
  () => {

    runSearch();

  }
);


/* =========================================================
   LIVE SEARCH
   Ketik langsung → hasil langsung berubah
========================================================= */

input?.addEventListener(
  "input",
  () => {

    runSearch();

  }
);


/* =========================================================
   LOAD QUERY DARI URL
========================================================= */

const urlParams =
  new URLSearchParams(
    window.location.search
  );


const urlKeyword =
  urlParams.get("q") || "";


const urlType =
  urlParams.get("type") || "all";


input.value =
  urlKeyword;


if (
  [
    "all",
    "blog",
    "tool",
    "product"
  ].includes(urlType)
) {

  filter.value =
    urlType;

}


/* =========================================================
   JIKA ADA ?q=...
========================================================= */

if (
  urlKeyword.trim()
) {

  runSearch();

}

</script>


<style>

/* =========================================================
   PAGE
========================================================= */

.search-page{

  width:
    min(
      100% - 40px,
      1000px
    );

  margin:
    0 auto;

  padding:
    60px 0 90px;

  color:
    var(--text);

}


/* =========================================================
   HEADER
========================================================= */

.search-header{

  margin-bottom:
    30px;

}


.search-label{

  display:
    inline-block;

  margin-bottom:
    8px;

  color:
    var(--primary);

  font-size:
    10px;

  font-weight:
    800;

  letter-spacing:
    1.6px;

}


.search-header h1{

  margin:
    0;

  font-size:
    clamp(
      30px,
      5vw,
      42px
    );

  line-height:
    1.15;

  letter-spacing:
    -1px;

}


.search-header p{

  margin:
    10px 0 0;

  color:
    var(--text-secondary);

  font-size:
    14px;

  line-height:
    1.7;

}


/* =========================================================
   FORM
========================================================= */

.search-form{

  display:
    grid;

  grid-template-columns:
    minmax(0, 1fr)
    150px
    110px;

  gap:
    10px;

  margin-bottom:
    18px;

}


.search-input-wrap{

  position:
    relative;

}


.search-input-wrap svg{

  position:
    absolute;

  top:
    50%;

  left:
    14px;

  width:
    18px;

  height:
    18px;

  transform:
    translateY(-50%);

  color:
    var(--text-secondary);

  pointer-events:
    none;

}


#searchInput,
#typeFilter{

  width:
    100%;

  height:
    48px;

  box-sizing:
    border-box;

  border:
    1px solid var(--border);

  border-radius:
    10px;

  outline:
    none;

  background:
    var(--surface);

  color:
    var(--text);

  font-family:
    inherit;

  font-size:
    13px;

}


#searchInput{

  padding:
    0 14px 0 43px;

}


#typeFilter{

  padding:
    0 12px;

}


#searchInput:focus,
#typeFilter:focus{

  border-color:
    var(--primary);

  box-shadow:
    0 0 0 3px
    color-mix(
      in srgb,
      var(--primary) 10%,
      transparent
    );

}


/* =========================================================
   BUTTON
========================================================= */

.search-btn{

  height:
    48px;

  border:
    0;

  border-radius:
    10px;

  background:
    var(--bgbtn);

  color:
    var(--textbtn);

  font-family:
    inherit;

  font-size:
    12px;

  font-weight:
    800;

  cursor:
    pointer;

  transition:
    transform .2s,
    filter .2s;

}


.search-btn:hover{

  transform:
    translateY(-1px);

  filter:
    brightness(1.08);

}


/* =========================================================
   RESULT INFO
========================================================= */

.result-info{

  margin-bottom:
    16px;

  color:
    var(--text-secondary);

  font-size:
    12px;

}


/* =========================================================
   RESULTS
========================================================= */

.results{

  display:
    grid;

  gap:
    12px;

}


/* =========================================================
   PENTING:
   SEMUA HASIL TERSEMBUNYI SEBELUM SEARCH
========================================================= */

.search-item{

  display:
    none;

}


.item{

  padding:
    18px;

  border:
    1px solid var(--border);

  border-radius:
    12px;

  background:
    var(--surface);

  color:
    var(--text);

  text-decoration:
    none;

  box-shadow:
    var(--shadow);

  transition:
    transform .2s,
    border-color .2s;

}


.item:hover{

  transform:
    translateY(-2px);

  border-color:
    color-mix(
      in srgb,
      var(--primary) 45%,
      var(--border)
    );

}


.item h2{

  margin:
    0 0 7px;

  font-size:
    16px;

  line-height:
    1.4;

}


.item p{

  margin:
    0;

  color:
    var(--text-secondary);

  font-size:
    12px;

  line-height:
    1.65;

}


/* =========================================================
   BADGE
========================================================= */

.badge{

  display:
