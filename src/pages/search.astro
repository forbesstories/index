---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";

interface Tool {
  title: string;
  description: string;
  url: string;
}

interface Blog {
  title: string;
  description: string;
  url: string;
}


/* =========================================================
   BLOG
========================================================= */

const posts =
  await getCollection("blog");


/* =========================================================
   TOOLS DIRECTORY
========================================================= */

const toolsDir =
  path.resolve("./src/pages/tools");


/* =========================================================
   RECURSIVE SCAN ASTRO
========================================================= */

function getAstroFiles(
  dir: string
): string[] {

  if (!fs.existsSync(dir)) {
    return [];
  }

  const entries =
    fs.readdirSync(
      dir,
      {
        withFileTypes: true
      }
    );

  const files: string[] = [];

  for (const entry of entries) {

    const fullPath =
      path.join(
        dir,
        entry.name
      );

    if (entry.isDirectory()) {

      files.push(
        ...getAstroFiles(
          fullPath
        )
      );

    }

    else if (
      entry.name.endsWith(".astro")
    ) {

      files.push(
        fullPath
      );

    }

  }

  return files;

}


/* =========================================================
   EXTRACT TITLE / DESCRIPTION
========================================================= */

function extractValue(
  content: string,
  name: string
): string {

  const patterns = [

    /* const title = "..." */

    new RegExp(
      `(?:const|let|var)\\s+${name}\\s*=\\s*["'\`]([^"'\\\`]+)["'\`]`,
      "m"
    ),

    /* title: "..." */

    new RegExp(
      `${name}\\s*:\\s*["'\`]([^"'\\\`]+)["'\`]`,
      "m"
    ),

    /* title="..." */

    new RegExp(
      `${name}\\s*=\\s*["'\`]([^"'\\\`]+)["'\`]`,
      "m"
    )

  ];

  for (
    const regex of patterns
  ) {

    const match =
      content.match(regex);

    if (match?.[1]) {

      return match[1].trim();

    }

  }

  return "";

}


/* =========================================================
   TOOL URL
========================================================= */

function createToolUrl(
  file: string
): string {

  let relative =
    path.relative(
      toolsDir,
      file
    );

  relative =
    relative
      .replace(
        /\\/g,
        "/"
      )
      .replace(
        /\.astro$/,
        ""
      );


  /*
   * /tools/category/index
   *
   * menjadi
   *
   * /tools/category
   */

  if (
    relative.endsWith("/index")
  ) {

    relative =
      relative.slice(
        0,
        -6
      );

  }


  return `/tools/${relative}`;

}


/* =========================================================
   READ TOOLS
========================================================= */

const files =
  getAstroFiles(
    toolsDir
  );


const tools: Tool[] =
  files

    .map(
      (file) => {

        const content =
          fs.readFileSync(
            file,
            "utf8"
          );


        const title =
          extractValue(
            content,
            "title"
          );


        const description =
          extractValue(
            content,
            "description"
          );


        return {

          title,

          description,

          url:
            createToolUrl(
              file
            )

        };

      }
    )

    .filter(
      (tool) =>
        tool.title
    )

    .sort(
      (a, b) =>
        a.title.localeCompare(
          b.title
        )
    );


/* =========================================================
   BLOG DATA
========================================================= */

const blogs: Blog[] =
  posts

    .map(
      (post) => ({

        title:
          post.data.title,

        description:
          post.data.description || "",

        url:
          `/blog/${post.slug}/`

      })
    )

    .filter(
      (post) =>
        post.title
    );

---


<MainLayout
  title="Pencarian | AI Mr Ferdy"
  description="Cari artikel dan tools AI Mr Ferdy berdasarkan judul dan deskripsi."
>


  <section class="search-section">

    <div class="search-container">


      <!-- =================================================
           HEADER
      ================================================== -->

      <h1>
        Pencarian AI Mr Ferdy
      </h1>


      <p class="search-description">
        Cari artikel atau tools berdasarkan nama dan deskripsi.
      </p>


      <!-- =================================================
           SEARCH
      ================================================== -->

      <div class="search-form">

        <input
          type="search"
          id="searchInput"
          placeholder="Cari artikel atau tools..."
          autocomplete="off"
          spellcheck="false"
        />


        <select
          id="searchType"
          aria-label="Jenis pencarian"
        >

          <option value="all">
            Semua
          </option>

          <option value="tool">
            Tools
          </option>

          <option value="blog">
            Blog
          </option>

        </select>


        <button
          type="button"
          id="searchButton"
        >
          Search
        </button>

      </div>


      <!-- =================================================
           INFO
      ================================================== -->

      <div
        id="searchInfo"
        class="search-info"
      ></div>


      <!-- =================================================
           RESULTS
      ================================================== -->

      <div
        id="searchResults"
        class="search-results"
      ></div>


      <!-- =================================================
           EMPTY
      ================================================== -->

      <div
        id="emptySearch"
        class="empty-search"
      >

        Ketik kata kunci untuk mencari.

      </div>


      <!-- =================================================
           NO RESULT
      ================================================== -->

      <div
        id="noResults"
        class="no-results"
      >

        Tidak ada hasil ditemukan.

      </div>

    </div>

  </section>

</MainLayout>


<script
  define:vars={{
    tools,
    blogs
  }}
>

  const input =
    document.querySelector(
      "#searchInput"
    );

  const type =
    document.querySelector(
      "#searchType"
    );

  const button =
    document.querySelector(
      "#searchButton"
    );

  const results =
    document.querySelector(
      "#searchResults"
    );

  const info =
    document.querySelector(
      "#searchInfo"
    );

  const empty =
    document.querySelector(
      "#emptySearch"
    );

  const noResults =
    document.querySelector(
      "#noResults"
    );


  /* =====================================================
     ESCAPE HTML
  ====================================================== */

  function escapeHTML(
    value
  ) {

    return String(value)
      .replace(
        /&/g,
        "&amp;"
      )
      .replace(
        /</g,
        "&lt;"
      )
      .replace(
        />/g,
        "&gt;"
      )
      .replace(
        /"/g,
        "&quot;"
      )
      .replace(
        /'/g,
        "&#039;"
      );

  }


  /* =====================================================
     SEARCH
  ====================================================== */

  function search() {

    const keyword =
      input.value
        .trim()
        .toLowerCase();


    const selectedType =
      type.value;


    /*
     * BELUM ADA KEYWORD
     */

    if (!keyword) {

      results.innerHTML = "";

      info.textContent = "";

      empty.style.display =
        "block";

      noResults.style.display =
        "none";

      return;

    }


    /*
     * PILIH DATA
     *
     * type=tool
     * -> hanya tools
     *
     * type=blog
     * -> hanya blog
     *
     * type=all
     * -> tools + blog
     */

    let data = [];


    if (
      selectedType === "tool"
    ) {

      data =
        tools.map(
          tool => ({
            ...tool,
            type: "tool"
          })
        );

    }

    else if (
      selectedType === "blog"
    ) {

      data =
        blogs.map(
          blog => ({
            ...blog,
            type: "blog"
          })
        );

    }

    else {

      data = [

        ...tools.map(
          tool => ({
            ...tool,
            type: "tool"
          })
        ),

        ...blogs.map(
          blog => ({
            ...blog,
            type: "blog"
          })
        )

      ];

    }


    /*
     * FILTER
     */

    const found =
      data.filter(
        item => {

          const title =
            (
              item.title || ""
            )
              .toLowerCase();


          const description =
            (
              item.description || ""
            )
              .toLowerCase();


          return (
            title.includes(keyword) ||
            description.includes(keyword)
          );

        }
      );


    /*
     * HIDE EMPTY
     */

    empty.style.display =
      "none";


    /*
     * INFO
     */

    info.textContent =
      `${found.length} hasil ditemukan`;


    /*
     * NO RESULT
     */

    if (
      found.length === 0
    ) {

      results.innerHTML = "";

      noResults.style.display =
        "block";

      return;

    }


    noResults.style.display =
      "none";


    /*
     * HASIL
     */

    results.innerHTML =
      found.map(
        item => {

          const badge =
            item.type === "tool"
              ? "Tool"
              : "Blog";


          return `

            <a
              class="search-card"
              href="${escapeHTML(item.url)}"
            >

              <span class="search-badge">
                ${badge}
              </span>

              <h2>
                ${escapeHTML(
                  item.title
                )}
              </h2>

              ${
                item.description
                  ? `
                    <p>
                      ${escapeHTML(
                        item.description
                      )}
                    </p>
                  `
                  : ""
              }

            </a>

          `;

        }
      ).join("");

  }


  /* =====================================================
     INPUT
  ====================================================== */

  input.addEventListener(
    "input",
    search
  );


  /* =====================================================
     BUTTON
  ====================================================== */

  button.addEventListener(
    "click",
    search
  );


  /* =====================================================
     TYPE
  ====================================================== */

  type.addEventListener(
    "change",
    () => {

      search();

      updateURL();

    }
  );


  /* =====================================================
     URL
  ====================================================== */

  function updateURL() {

    const keyword =
      input.value.trim();

    const selectedType =
      type.value;


    const params =
      new URLSearchParams();


    if (keyword) {

      params.set(
        "q",
        keyword
      );

    }


    if (
      selectedType !== "all"
    ) {

      params.set(
        "type",
        selectedType
      );

    }


    const query =
      params.toString();


    history.replaceState(
      {},
      "",
      query
        ? `${location.pathname}?${query}`
        : location.pathname
    );

  }


  /* =====================================================
     SUBMIT
  ====================================================== */

  input.addEventListener(
    "keydown",
    event => {

      if (
        event.key === "Enter"
      ) {

        event.preventDefault();

        search();

        updateURL();

      }

    }
  );


  /* =====================================================
     LOAD QUERY URL
  ====================================================== */

  const params =
    new URLSearchParams(
      location.search
    );


  const urlKeyword =
    params.get("q") || "";


  const urlType =
    params.get("type") || "all";


  input.value =
    urlKeyword;


  if (
    urlType === "tool" ||
    urlType === "blog" ||
    urlType === "all"
  ) {

    type.value =
      urlType;

  }


  /*
   * HANYA SEARCH KALAU ADA q
   */

  if (
    urlKeyword.trim()
  ) {

    search();

  }

</script>


<style>

.search-section {

  width: 100%;

  padding:
    50px 20px;

  box-sizing: border-box;

}


.search-container {

  width: 100%;

  max-width: 1000px;

  margin: 0 auto;

}


.search-container h1 {

  margin:
    0 0 10px;

  text-align:
    center;

  font-size:
    32px;

}


.search-description {

  margin:
    0 0 25px;

  text-align:
    center;

  opacity:
    .75;

}


/* =========================================================
   FORM
========================================================= */

.search-form {

  display:
    grid;

  grid-template-columns:
    minmax(0, 1fr)
    150px
    110px;

  gap:
    10px;

  margin-bottom:
    15px;

}


.search-form input,
.search-form select,
.search-form button {

  height:
    52px;

  box-sizing:
    border-box;

  border-radius:
    10px;

  font-family:
    inherit;

}


.search-form input {

  width:
    100%;

  padding:
    0 18px;

  border:
    1px solid #ccc;

  outline:
    none;

  font-size:
    16px;

  background:
    #fff;

}


.search-form select {

  width:
    100%;

  padding:
    0 12px;

  border:
    1px solid #ccc;

  background:
    #fff;

}


.search-form button {

  border:
    0;

  background:
    var(--bgbtn);

  color:
    var(--textbtn);

  font-weight:
    800;

  cursor:
    pointer;

}


.search-form input:focus,
.search-form select:focus {

  border-color:
    #2563eb;

}


/* =========================================================
   INFO
========================================================= */

.search-info {

  margin:
    10px 0 15px;

  font-size:
    14px;

  opacity:
    .7;

}


/* =========================================================
   RESULTS
========================================================= */

.search-results {

  display:
    grid;

  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );

  gap:
    15px;

}


.search-card {

  display:
    block;

  padding:
    20px;

  border:
    1px solid #ddd;

  border-radius:
    12px;

  text-decoration:
    none;

  color:
    inherit;

  background:
    #fff;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;

}


.search-card:hover {

  transform:
    translateY(-2px);

  border-color:
    #2563eb;

  box-shadow:
    0 8px 25px
    rgba(
      0,
      0,
      0,
      .08
    );

}


.search-card h2 {

  margin:
    0 0 8px;

  font-size:
    18px;

}


.search-card p {

  margin:
    0;

  line-height:
    1.6;

  font-size:
    14px;

  opacity:
    .75;

}


/* =========================================================
   BADGE
========================================================= */

.search-badge {

  display:
    inline-block;

  margin-bottom:
    10px;

  padding:
    4px 9px;

  border-radius:
    999px;

  background:
    rgba(
      37,
      99,
      235,
      .08
    );

  color:
    #2563eb;

  font-size:
    10px;

  font-weight:
    800;

}


/* =========================================================
   EMPTY
========================================================= */

.empty-search,
.no-results {

  padding:
    30px 20px;

  text-align:
    center;

  opacity:
    .65;

}


.no-results {

  display:
    none;

}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:700px) {

  .search-section {

    padding:
      35px 15px;

  }


  .search-container h1 {

    font-size:
      26px;

  }


  .search-form {

    grid-template-columns:
      1fr;

  }


  .search-results {

    grid-template-columns:
      1fr;

  }

}

</style>
