---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const products = await getCollection("product");




const toolFiles = import.meta.glob(
  "./tools/**/*.astro",
  {
    eager: true,
    query: "?raw",
    import: "default"
  }
);


/* =========================================================
   PARSE TOOL
========================================================= */

function parseTool(
  path,
  source
) {

  const cleanSource =
    String(source || "");


  /* =======================================================
     PATH
  ======================================================= */

  const relativePath =
    path
      .replace(/^\.\/tools\//, "")
      .replace(/\.astro$/, "");


  const parts =
    relativePath.split("/");


  const filename =
    parts[parts.length - 1] || "";


  /* =======================================================
     URL
  ======================================================= */

  const href =
    `/tools/${relativePath}/`;


  /* =======================================================
     TITLE
  ======================================================= */

  let title = "";


  /*
   * Cari:
   *
   * title="Audio Converter"
   *
   * atau:
   *
   * title='Audio Converter'
   */

  const titleMatch =
    cleanSource.match(
      /title\s*=\s*["']([^"']+)["']/
    );


  if (titleMatch) {

    title =
      titleMatch[1].trim();

  }


  /*
   * Kalau tidak ditemukan,
   * gunakan nama file.
   */

  if (!title) {

    title =
      filename
        .replace(/[-_]+/g, " ")
        .replace(/\b\w/g, char =>
          char.toUpperCase()
        );

  }


  /* =======================================================
     DESCRIPTION
  ======================================================= */

  let description = "";


  const descriptionMatch =
    cleanSource.match(
      /description\s*=\s*["']([^"']+)["']/
    );


  if (descriptionMatch) {

    description =
      descriptionMatch[1].trim();

  }


  /*
   * Fallback description
   */

  if (!description) {

    description =
      `Online tool ${title} untuk membantu kebutuhan Anda.`;

  }


  /* =======================================================
     CATEGORY
  ======================================================= */

  const category =
    parts.length > 1
      ? parts[0]
      : "Tools";


  const categoryTitle =
    category
      .replace(/[-_]+/g, " ")
      .replace(/\b\w/g, char =>
        char.toUpperCase()
      );


  /* =======================================================
     SEARCH TEXT
     
     SELURUH SOURCE ASTRO ikut dimasukkan.
     
     Jadi kata "Audio" tetap ditemukan walaupun:
     - title tidak mengandung Audio
     - description tidak mengandung Audio
     - Audio hanya ada di isi halaman
  ======================================================= */

  const searchText =
    [
      title,
      description,
      categoryTitle,
      relativePath,
      cleanSource
    ]
      .join(" ")
      .toLowerCase();


  return {

    title,

    description,

    href,

    category:
      categoryTitle,

    searchText

  };

}


/* =========================================================
   BUILD TOOL INDEX
========================================================= */

const tools =
  Object.entries(toolFiles)

    .map(
      ([path, source]) =>
        parseTool(path, source)
    )

    .filter(
      (tool) =>
        tool.href !== "/tools/index/"
    )

    .sort(
      (a, b) =>
        a.title.localeCompare(
          b.title,
          "id"
        )
    );
---
