---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../lib/site";
import "../styles/pages.css";

const pageTitle = `Pricing - ${SITE.name || "Ai Mr Ferdy"}`;

const pageDescription =
  "Informasi paket dan pilihan layanan digital Ai Mr Ferdy untuk kebutuhan website, SEO, AI, tools, dan teknologi modern.";
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE.url()}/pricing`}
>

  <main class="page page-pricing">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="page-hero">

      <div class="page-container">

        <span class="page-label">
          PRICING
        </span>

        <h1>
          Pilih Solusi Digital
          Sesuai Kebutuhan Anda
        </h1>

        <p>
          Pilih pendekatan yang sesuai dengan kebutuhan
          website, SEO, AI, tools, dan pengembangan
          digital Anda.
        </p>

      </div>

    </section>


    <!-- =====================================================
         PLANS
    ====================================================== -->

    <section class="page-section">

      <div class="page-container">

        <div class="page-section-heading">

          <span class="page-label">
            PLANS
          </span>

          <h2>
            Pilihan Layanan
          </h2>

          <p>
            Setiap kebutuhan dapat memiliki pendekatan
            yang berbeda. Mulai dari kebutuhan sederhana
            hingga pengembangan yang lebih kompleks.
          </p>

        </div>


        <div class="page-grid">

          <article class="page-card">

            <span class="page-label">
              STARTER
            </span>

            <h3>
              Basic
            </h3>

            <p>
              Cocok untuk kebutuhan awal seperti
              konsultasi, evaluasi website, atau
              perencanaan digital.
            </p>

            <div class="page-divider"></div>

            <ul>
              <li>Initial consultation</li>
              <li>Basic website review</li>
              <li>SEO direction</li>
              <li>Action recommendations</li>
            </ul>

            <a
              href="/contact/"
              class="page-button page-button-secondary"
            >
              Konsultasi
            </a>

          </article>


          <article class="page-card page-card-featured">

            <span class="page-label">
              POPULAR
            </span>

            <h3>
              Growth
            </h3>

            <p>
              Untuk kebutuhan optimasi dan pengembangan
              digital yang membutuhkan strategi lebih
              menyeluruh.
            </p>

            <div class="page-divider"></div>

            <ul>
              <li>SEO strategy</li>
              <li>Technical optimization</li>
              <li>Content direction</li>
              <li>Performance recommendations</li>
            </ul>

            <a
              href="/contact/"
              class="page-button page-button-primary"
            >
              Mulai Diskusi
            </a>

          </article>


          <article class="page-card">

            <span class="page-label">
              ADVANCED
            </span>

            <h3>
              Custom
            </h3>

            <p>
              Solusi yang disesuaikan dengan kebutuhan
              proyek, sistem, website, AI, atau
              automation tertentu.
            </p>

            <div class="page-divider"></div>

            <ul>
              <li>Custom requirements</li>
              <li>Advanced planning</li>
              <li>AI & automation direction</li>
              <li>Project-specific strategy</li>
            </ul>

            <a
              href="/contact/"
              class="page-button page-button-secondary"
            >
              Hubungi Kami
            </a>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         INFORMATION
    ====================================================== -->

    <section class="page-section">

      <div class="page-container">

        <div class="page-section-heading">

          <span class="page-label">
            INFORMATION
          </span>

          <h2>
            Tidak Ada Paket yang Cocok?
          </h2>

          <p>
            Tidak semua proyek memiliki kebutuhan yang
            sama. Jika kebutuhan Anda berbeda dari pilihan
            di atas, solusi dapat dibicarakan secara
            langsung.
          </p>

        </div>


        <div class="page-legal">

          <div class="page-legal-section">

            <h3>
              Custom Project
            </h3>

            <p>
              Untuk proyek dengan kebutuhan khusus,
              ruang lingkup pekerjaan dapat disesuaikan
              berdasarkan tujuan, teknologi, dan tingkat
              kompleksitas proyek.
            </p>

          </div>


          <div class="page-legal-section">

            <h3>
              Harga dan Scope
            </h3>

            <p>
              Biaya layanan dapat berbeda berdasarkan
              ruang lingkup, fitur, tingkat pengerjaan,
              serta kebutuhan teknis masing-masing proyek.
            </p>

          </div>


          <div class="page-legal-section">

            <h3>
              Konsultasi
            </h3>

            <p>
              Hubungi Ai Mr Ferdy terlebih dahulu untuk
              menjelaskan kebutuhan sebelum menentukan
              layanan yang paling sesuai.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="page-cta">

      <div class="page-container">

        <span class="page-label">
          GET STARTED
        </span>

        <h2>
          Punya Kebutuhan Digital Khusus?
        </h2>

        <p>
          Mari diskusikan kebutuhan Anda dan tentukan
          pendekatan yang paling sesuai.
        </p>

        <a
          href="/contact/"
          class="page-button page-button-primary"
        >
          Hubungi Ai Mr Ferdy
        </a>

      </div>

    </section>

  </main>

</MainLayout>
