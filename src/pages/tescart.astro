========================= -->

<main class="product">


  <!-- GALLERY -->

  <section class="gallery">

    <div class="gallery-main">

      <button
        class="gallery-arrow arrow-left"
        aria-label="Previous image">
        ‹
      </button>

      <img
        id="mainImage"
        src="https://bcpturbo.com/cdn/shop/files/DSC_1940_c00da42c-a195-4475-ac96-afc90e1edb27.jpg?v=1764449527"
        alt="BCP X500 WRX FA20 Turbocharger"
      >

      <button
        class="gallery-arrow arrow-right"
        aria-label="Next image">
