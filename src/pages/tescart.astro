      </button>

    </div>


    <div class="thumbnails">

      <button class="thumbnail active">

        <img
          src="https://bcpturbo.com/cdn/shop/files/DSC_1940_c00da42c-a195-4475-ac96-afc90e1edb27.jpg?v=1764449527"
          alt=""
        >

      </button>


      <button class="thumbnail">

        <img
          src="https://bcpturbo.com/cdn/shop/files/DSC_1941_35daab40-4139-4e7d-825b-3d014230e103.jpg?v=1764449527"
          alt=""
        >

      </button>


      <button class="thumbnail">

        <img
          src="https://bcpturbo.com/cdn/shop/files/DSC_2033_4b4ee3f2-729e-4752-b7d7-7617566753a5.jpg?v=1764449527"
          alt=""
        >

      </button>

    </div>

  </section>



  <!-- PRODUCT INFO -->

  <section class="info">

    <p class="vendor">
      BCP Turbo
    </p>


    <h1 class="title">
      BCP X500 WRX FA20 Turbocharger
    </h1>


    <div class="rating">

      <span class="stars">
