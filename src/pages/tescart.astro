      </p>

    </div>

  </div>



  <div class="accordion-item">

    <button class="accordion-title">

      <span>
        Shipping & returns
      </span>

      <span class="accordion-icon">
        +
      </span>

    </button>


    <div class="accordion-content">

      <p>
        Shipping and return information can be
        displayed here.
      </p>

    </div>

  </div>

</section>



<!-- CART MESSAGE -->

<div
  class="cart-message"
  id="cartMessage">

  Product added to cart

</div>



<script>

/* =========================
   PRODUCT IMAGES
========================= */

const images = [

  "https://bcpturbo.com/cdn/shop/files/DSC_1940_c00da42c-a195-4475-ac96-afc90e1edb27.jpg?v=1764449527",

  "https://bcpturbo.com/cdn/shop/files/DSC_1941_35daab40-4139-4e7d-825b-3d014230e103.jpg?v=1764449527",

  "https://bcpturbo.com/cdn/shop/files/DSC_2033_4b4ee3f2-729e-4752-b7d7-7617566753a5.jpg?v=1764449527"

];

let currentImage = 0;

const mainImage =
  document.getElementById("mainImage");

const thumbnails =
  document.querySelectorAll(".thumbnail");


/* change image */

function showImage(index) {

  if (index < 0) {
    index = images.length - 1;
  }

  if (index >= images.length) {
    index = 0;
  }

  currentImage = index;

  mainImage.src = images[index];

  thumbnails.forEach((thumb, i) => {

    thumb.classList.toggle(
      "active",
      i === index
    );

  });

}


/* thumbnail */

thumbnails.forEach((thumb, index) => {

  thumb.addEventListener("click", () => {

    showImage(index);

  });

});


/* arrows */

document
  .querySelector(".arrow-left")
  .addEventListener("click", () => {

    showImage(currentImage - 1);

  });


document
  .querySelector(".arrow-right")
  .addEventListener("click", () => {

    showImage(currentImage + 1);

  });



/* =========================
   QUANTITY
========================= */

const quantity =
  document.getElementById("quantity");


document
  .getElementById("minus")
  .addEventListener("click", () => {

    let value =
      parseInt(quantity.value) || 1;

    if (value > 1) {
      value--;
    }

    quantity.value = value;

  });


document
  .getElementById("plus")
  .addEventListener("click", () => {

    let value =
      parseInt(quantity.value) || 1;

    value++;

    quantity.value = value;

  });


quantity.addEventListener("change", () => {

  if (
    !quantity.value ||
    quantity.value < 1
  ) {
    quantity.value = 1;
  }

});



/* =========================
   CART
========================= */

let cartCount = 0;

const cartNumber =
  document.querySelector(".cart-number");

const cartMessage =
  document.getElementById("cartMessage");


function addToCart() {

  const amount =
    parseInt(quantity.value) || 1;

  cartCount += amount;

  cartNumber.textContent =
    cartCount;

  cartMessage.classList.add("show");


  setTimeout(() => {

    cartMessage.classList.remove("show");

  }, 2200);

}


document
  .getElementById("addCart")
  .addEventListener("click", addToCart);



/* =========================
   BUY NOW
========================= */

document
  .getElementById("buyNow")
  .addEventListener("click", () => {

    const amount =
      parseInt(quantity.value) || 1;

    cartCount += amount;

    cartNumber.textContent =
      cartCount;

    cartMessage.textContent =
      "Proceeding to checkout...";

    cartMessage.classList.add("show");


    setTimeout(() => {

      cartMessage.classList.remove("show");

    }, 2200);

  });



/* =========================
   ACCORDION
========================= */

const accordionButtons =
  document.querySelectorAll(
    ".accordion-title"
  );


accordionButtons.forEach(button => {

  button.addEventListener("click", () => {

    const item =
      button.parentElement;

    item.classList.toggle("open");

  });

});



/* =========================
   MOBILE MENU
========================= */

const menuButton =
  document.querySelector(".menu-btn");

const mobileMenu =
  document.querySelector(".mobile-menu");


menuButton.addEventListener("click", () => {

  mobileMenu.classList.toggle("open");

});


</script>

</body>
</html>
