<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BCP X500 WRX FA20 Turbocharger</title>

<style>

/* =========================
   RESET
========================= */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: #111;
  background: #fff;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  max-width: 100%;
}


/* =========================
   HEADER
========================= */

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1px solid #e5e5e5;
}

.header-top {
  height: 72px;
  max-width: 1400px;
  margin: auto;
  padding: 0 30px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  color: #111;
  text-decoration: none;
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -1px;
}

.nav {
  display: flex;
  align-items: center;
  gap: 32px;
}

.nav a {
  color: #222;
  text-decoration: none;
  font-size: 14px;
}

.nav a:hover {
  opacity: .55;
}

.actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.action-btn {
  position: relative;
  border: 0;
  background: transparent;
  padding: 5px;
  color: #111;
  font-size: 21px;
}

.cart-number {
  position: absolute;
  top: -5px;
  right: -8px;

  min-width: 17px;
  height: 17px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #111;
  color: #fff;

  border-radius: 50%;
  font-size: 10px;
}

.menu-btn {
  display: none;
}


/* =========================
   SECOND NAV
========================= */

.subnav {
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
}

.subnav-inner {
  max-width: 1400px;
  margin: auto;
  min-height: 48px;
  padding: 0 30px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 35px;
}

.subnav a {
  color: #222;
  text-decoration: none;
  font-size: 13px;
}


/* =========================
   PRODUCT
========================= */

.product {
  max-width: 1400px;
  margin: 45px auto 100px;
  padding: 0 30px;

  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(400px, .9fr);
  gap: 70px;
}


/* =========================
   GALLERY
========================= */

.gallery {
  min-width: 0;
}

.gallery-main {
  position: relative;

  width: 100%;
  aspect-ratio: 1.35;

  background: #f6f6f6;
  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-main img {
  width: 100%;
  height: 100%;
  object-fit: contain;

  transition: opacity .2s ease,
              transform .3s ease;
}

.gallery-main:hover img {
  transform: scale(1.02);
}


/* arrows */

.gallery-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);

  width: 42px;
  height: 42px;

  border: 0;
  border-radius: 50%;

  background: rgba(255,255,255,.9);

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 23px;
  z-index: 2;
}

.gallery-arrow:hover {
  background: #fff;
}

.arrow-left {
  left: 15px;
}

.arrow-right {
  right: 15px;
}


/* thumbnails */

.thumbnails {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;

  margin-top: 14px;
}

.thumbnail {
  border: 1px solid #ddd;
  background: #fff;
  padding: 0;
  aspect-ratio: 1.35;
  overflow: hidden;
}

.thumbnail.active {
  border: 2px solid #111;
}

.thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}


/* =========================
   PRODUCT INFO
========================= */

.info {
  position: sticky;
  top: 125px;
  align-self: start;
}

.vendor {
  margin: 0 0 15px;

  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.title {
  margin: 0;

  font-size: clamp(32px, 4vw, 50px);
  line-height: 1.05;
  letter-spacing: -1.8px;
  font-weight: 600;
}


/* rating */

.rating {
  display: flex;
  align-items: center;
  gap: 8px;

  margin: 20px 0;
}

.stars {
  color: #108474;
  font-size: 16px;
  letter-spacing: 2px;
}

.rating-text {
  font-size: 13px;
  color: #666;
}


/* price */

.price {
  margin: 25px 0;

  font-size: 30px;
  font-weight: 600;
}


/* description */

.description {
  color: #555;
  font-size: 15px;
  line-height: 1.75;
}

.description p {
  margin: 0 0 18px;
}

.description strong {
  color: #111;
}


/* stock */

.stock {
  margin: 25px 0;

  display: flex;
  align-items: center;
  gap: 8px;

  color: #16833b;
  font-size: 14px;
}

.stock-dot {
  width: 8px;
  height: 8px;

  background: #16833b;
  border-radius: 50%;
}


/* =========================
   BUY AREA
========================= */

.buy-area {
  margin-top: 28px;
}

.buy-row {
  display: grid;
  grid-template-columns: 125px 1fr;
  gap: 12px;
}


/* quantity */

.quantity {
  height: 54px;

  border: 1px solid #cfcfcf;

  display: grid;
  grid-template-columns: 38px 1fr 38px;
}

.quantity button {
  border: 0;
  background: #fff;

  font-size: 20px;
}

.quantity button:hover {
  background: #f5f5f5;
}

.quantity input {
  width: 100%;
  border: 0;

  text-align: center;
  outline: 0;
}


/* cart */

.add-cart {
  height: 54px;

  border: 0;
  background: #111;
  color: #fff;

  font-size: 15px;
  font-weight: 700;

  transition: .2s;
}

.add-cart:hover {
  background: #333;
}


/* buy now */

.buy-now {
  width: 100%;
  height: 54px;

  margin-top: 10px;

  border: 1px solid #111;
  background: #fff;
  color: #111;

  font-weight: 700;
}

.buy-now:hover {
  background: #111;
  color: #fff;
}


/* =========================
   BENEFITS
========================= */

.benefits {
  margin-top: 30px;

  border-top: 1px solid #e5e5e5;
}

.benefit {
  padding: 15px 0;

  border-bottom: 1px solid #e5e5e5;

  display: flex;
  align-items: center;
  gap: 12px;

  font-size: 13px;
}

.benefit-icon {
  font-size: 17px;
}


/* =========================
   ACCORDION
========================= */

.accordion {
  max-width: 900px;
  margin: 0 auto 100px;
  padding: 0 30px;
}

.accordion-item {
  border-top: 1px solid #ddd;
}

.accordion-item:last-child {
  border-bottom: 1px solid #ddd;
}

.accordion-title {
  width: 100%;

  padding: 22px 0;

  border: 0;
  background: transparent;

  display: flex;
  align-items: center;
  justify-content: space-between;

  text-align: left;
  font-size: 16px;
  font-weight: 600;
}

.accordion-icon {
  font-size: 22px;
  font-weight: 400;

  transition: transform .2s;
}

.accordion-content {
  display: none;

  padding: 0 0 25px;

  color: #555;
  font-size: 14px;
  line-height: 1.8;
}

.accordion-item.open .accordion-content {
  display: block;
}

.accordion-item.open .accordion-icon {
  transform: rotate(45deg);
}


/* =========================
   CART MESSAGE
========================= */

.cart-message {
  position: fixed;
  right: 25px;
  bottom: 25px;

  z-index: 200;

  padding: 16px 20px;

  background: #111;
  color: #fff;

  font-size: 14px;

  opacity: 0;
  visibility: hidden;
  transform: translateY(15px);

  transition: .25s;
}

.cart-message.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}


/* =========================
   MOBILE MENU
========================= */

.mobile-menu {
  display: none;

  padding: 15px 25px;

  border-top: 1px solid #eee;
  background: #fff;
}

.mobile-menu.open {
  display: block;
}

.mobile-menu a {
  display: block;

  padding: 13px 0;

  color: #111;
  text-decoration: none;

  border-bottom: 1px solid #eee;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {

  .header-top {
    padding: 0 20px;
  }

  .nav,
  .subnav {
    display: none;
  }

  .menu-btn {
    display: block;
  }

  .product {
    grid-template-columns: 1fr;
    gap: 40px;

    margin-top: 25px;
    padding: 0 20px;
  }

  .info {
    position: static;
  }

  .title {
    font-size: 36px;
  }

  .accordion {
    padding: 0 20px;
  }
}


@media (max-width: 600px) {

  .header-top {
    height: 62px;
  }

  .logo {
    font-size: 21px;
  }

  .actions {
    gap: 10px;
  }

  .product {
    margin-bottom: 60px;
  }

  .gallery-main {
    aspect-ratio: 1.1;
  }

  .thumbnails {
    gap: 7px;
  }

  .title {
    font-size: 31px;
    letter-spacing: -1px;
  }

  .price {
    font-size: 27px;
  }

  .buy-row {
    grid-template-columns: 110px 1fr;
  }

  .cart-message {
    left: 15px;
    right: 15px;
    bottom: 15px;
    text-align: center;
  }
}


</style>
</head>


<body>


<!-- =========================
     HEADER
========================= -->

