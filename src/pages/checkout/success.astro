---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Checkout Berhasil | AI Mr Ferdy"
  description="Pesanan Anda berhasil diproses."
  canonical="/checkout/success/"
>

  <main class="success-page">

    <section class="success-card">

      <div class="success-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 6 9 17l-5-5"/>
        </svg>
      </div>

      <span class="success-label">
        ORDER CONFIRMED
      </span>

      <h1>
        Checkout Berhasil
      </h1>

      <p class="success-description">
        Terima kasih. Pesanan Anda telah berhasil dibuat.
        Detail pesanan akan ditampilkan pada halaman ini.
      </p>

      <div class="order-box">

        <div class="order-row">
          <span>Status</span>
          <strong class="status">
            Berhasil
          </strong>
        </div>

        <div class="order-row">
          <span>Order ID</span>
          <strong id="orderId">
            -
          </strong>
        </div>

        <div class="order-row">
          <span>Total</span>
          <strong id="orderTotal">
            -
          </strong>
        </div>

      </div>

      <div class="success-actions">

        <a href="/product/" class="btn btn-primary">
          Lanjut Belanja
        </a>

        <a href="/" class="btn btn-secondary">
          Kembali ke Home
        </a>

      </div>

    </section>

  </main>

</MainLayout>

<script>
  const orderIdElement =
    document.querySelector("#orderId");

  const orderTotalElement =
    document.querySelector("#orderTotal");

  function getCheckoutData() {
    try {
      return JSON.parse(
        sessionStorage.getItem("checkoutOrder") || "null"
      );
    } catch {
      return null;
    }
  }

  const order = getCheckoutData();

  if (order) {

    if (orderIdElement) {
      orderIdElement.textContent =
        order.orderId || "-";
    }

    if (orderTotalElement) {
      orderTotalElement.textContent =
        order.total || "-";
    }

  } else {

    if (orderIdElement) {
      orderIdElement.textContent =
        "Tidak tersedia";
    }

    if (orderTotalElement) {
      orderTotalElement.textContent =
        "Tidak tersedia";
    }

  }
</script>

<style is:global>

.success-page{
  width:min(100% - 32px, 760px);
  min-height:calc(100vh - 180px);
  margin:0 auto;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:60px 0;
}

.success-card{
  width:100%;
  padding:45px;
  text-align:center;

  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);

  box-shadow:var(--shadow);

  position:relative;
  overflow:hidden;
}

.success-card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:3px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--primary),
      transparent
    );
}

.success-icon{
  width:76px;
  height:76px;

  margin:0 auto 22px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:50%;

  color:var(--primary);

  background:
    color-mix(
      in srgb,
      var(--primary) 10%,
      transparent
    );

  border:1px solid
    color-mix(
      in srgb,
      var(--primary) 25%,
      transparent
    );
}

.success-icon svg{
  width:38px;
  height:38px;
}

.success-label{
  display:block;

  margin-bottom:10px;

  color:var(--primary);

  font-size:11px;
  font-weight:800;
  letter-spacing:1.8px;
}

.success-card h1{
  margin:0;

  color:var(--text);

  font-size:clamp(28px,5vw,42px);
  line-height:1.15;
  letter-spacing:-1px;
}

.success-description{
  max-width:560px;

  margin:16px auto 28px;

  color:var(--text-secondary);

  font-size:14px;
  line-height:1.8;
}

.order-box{
  max-width:500px;

  margin:0 auto;

  padding:5px 18px;

  text-align:left;

  background:var(--surface-hover);

  border:1px solid var(--border);

  border-radius:var(--radius);
}

.order-row{
  min-height:52px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:20px;

  border-bottom:1px solid var(--border);

  font-size:13px;
}

.order-row:last-child{
  border-bottom:0;
}

.order-row span{
  color:var(--text-secondary);
}

.order-row strong{
  color:var(--text);
  font-weight:700;
  text-align:right;
}

.order-row .status{
  color:var(--primary);
}

.success-actions{
  margin-top:28px;

  display:flex;
  justify-content:center;

  gap:10px;
  flex-wrap:wrap;
}

.btn{
  min-height:46px;

  padding:0 20px;

  display:inline-flex;
  align-items:center;
  justify-content:center;

  border-radius:10px;

  font-size:13px;
  font-weight:700;

  text-decoration:none;

  transition:
    transform .2s ease,
    background .2s ease,
    border-color .2s ease;
}

.btn:hover{
  transform:translateY(-1px);
}

.btn-primary{
  color:var(--textbtn);
  background:var(--bgbtn);
}

.btn-primary:hover{
  filter:brightness(1.08);
}

.btn-secondary{
  color:var(--text);
  background:var(--surface);

  border:1px solid var(--border);
}

.btn-secondary:hover{
  background:var(--surface-hover);
  border-color:var(--primary);
  color:var(--primary);
}

@media(max-width:600px){

  .success-page{
    width:calc(100% - 24px);
    padding:35px 0;
  }

  .success-card{
    padding:32px 20px;
  }

  .success-icon{
    width:68px;
    height:68px;
  }

  .success-icon svg{
    width:34px;
    height:34px;
  }

  .order-box{
    padding:4px 14px;
  }

  .success-actions{
    flex-direction:column;
  }

  .btn{
    width:100%;
  }

}

</style>
