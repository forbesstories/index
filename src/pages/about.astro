---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

const pageTitle =
  'About Ai Mr Ferdy - AI, SEO & Digital Technology';

const pageDescription =
  'Mengenal Ai Mr Ferdy, platform digital yang membahas AI, SEO, automation, tools online, teknologi web, dan pengembangan produk digital modern.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE.url()}/about/`}
>

  <main class="about-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="about-hero">
      <div class="about-container">

        <div class="about-hero-grid">

          <div class="about-hero-content">

            <span class="about-hero-tag">
              ABOUT AI MR FERDY
            </span>

            <h1>
              Menghubungkan AI, Teknologi, dan Ekosistem Digital
            </h1>

            <p>
              Ai Mr Ferdy merupakan platform digital yang mengeksplorasi
              perkembangan artificial intelligence, SEO, automation,
              tools online, teknologi web, serta berbagai solusi digital
              yang relevan dengan kebutuhan internet saat ini.
            </p>

            <div class="about-hero-actions">

              <a
                href="https://aimrdennis.com"
                class="about-button about-button-primary"
              >
                Official Website
              </a>

              <a
                href="https://news.aimrdennis.com"
                class="about-button about-button-secondary"
              >
                Latest Articles
              </a>

            </div>

          </div>


          <div class="about-hero-cards">

            <article class="about-hero-card">

              <span class="about-card-label">
                TECHNOLOGY
              </span>

              <h2>
                AI & Automation
              </h2>

              <p>
                Mengeksplorasi pemanfaatan AI, automation, dan sistem
                digital untuk membuat berbagai proses menjadi lebih
                praktis dan efisien.
              </p>

            </article>


            <article class="about-hero-card">

              <span class="about-card-label">
                PERFORMANCE
              </span>

              <h2>
                Fast & Clean
              </h2>

              <p>
                Mengutamakan website yang ringan, responsif, mudah
                digunakan, serta memiliki struktur yang mendukung
                performa dan pengalaman pengguna.
              </p>

            </article>

          </div>

        </div>

      </div>
    </section>


    <!-- =====================================================
         ABOUT
    ====================================================== -->

    <section class="about-section">
      <div class="about-container">

        <div class="about-section-heading">

          <h2 class="about-section-title">
            Apa Itu Ai Mr Ferdy?
          </h2>

          <p class="about-section-description">
            Ruang digital untuk mempelajari, mencoba, dan mengeksplorasi
            perkembangan teknologi modern.
          </p>

        </div>


        <div class="about-feature-grid">

          <article class="about-feature-card">

            <h3>
              AI Technology
            </h3>

            <p>
              Membahas perkembangan artificial intelligence dan
              penerapannya dalam berbagai produk, sistem, serta
              kebutuhan digital sehari-hari.
            </p>

          </article>


          <article class="about-feature-card">

            <h3>
              SEO & Web Development
            </h3>

            <p>
              Mengeksplorasi teknik pengembangan website yang cepat,
              terstruktur, responsif, dan memiliki fondasi SEO yang baik.
            </p>

          </article>


          <article class="about-feature-card">

            <h3>
              Digital Tools
            </h3>

            <p>
              Menyediakan berbagai utility dan tools berbasis web yang
              dirancang agar dapat digunakan secara praktis langsung
              melalui browser.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- =====================================================
         MISSION
    ====================================================== -->

    <section class="about-section">
      <div class="about-container">

        <div class="about-section-heading">

          <h2 class="about-section-title">
            Fokus dan Prinsip
          </h2>

          <p class="about-section-description">
            Ai Mr Ferdy dibangun dengan perhatian pada kualitas,
            kesederhanaan, dan relevansi teknologi.
          </p>

        </div>


        <div class="about-mission-grid">

          <article class="about-mission-card">

            <h3>
              Modern Design
            </h3>

            <p>
              Menggunakan pendekatan desain yang sederhana dan
              intuitif agar informasi maupun tools dapat digunakan
              tanpa pengalaman yang rumit.
            </p>

          </article>


          <article class="about-mission-card">

            <h3>
              High Performance
            </h3>

            <p>
              Performa menjadi salah satu prioritas, mulai dari
              struktur halaman, kecepatan akses, hingga pengalaman
              penggunaan pada perangkat mobile.
            </p>

          </article>


          <article class="about-mission-card">

            <h3>
              Future Ready
            </h3>

            <p>
              Mengikuti perubahan teknologi dengan terus mengeksplorasi
              AI, automation, web development, dan berbagai inovasi
              digital yang berkembang.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- =====================================================
         FAQ
    ====================================================== -->

    <section class="about-section">
      <div class="about-container">

        <div class="about-section-heading">

          <h2 class="about-section-title">
            Tentang Platform Ai Mr Ferdy
          </h2>

          <p class="about-section-description">
            Beberapa hal yang sering ingin diketahui mengenai platform ini.
          </p>

        </div>


        <div class="about-faq">

          <article class="about-faq-item">

            <h3 class="about-faq-question">
              Apakah Ai Mr Ferdy membahas SEO?
            </h3>

            <div class="about-faq-answer">
              <p>
                Ya. SEO merupakan salah satu bagian dari topik yang
                dibahas, terutama yang berkaitan dengan struktur website,
                performa, konten, dan pengembangan web modern.
              </p>
            </div>

          </article>


          <article class="about-faq-item">

            <h3 class="about-faq-question">
              Apa fokus utama Ai Mr Ferdy?
            </h3>

            <div class="about-faq-answer">
              <p>
                Fokusnya mencakup AI, automation, teknologi web,
                digital tools, SEO, serta berbagai perkembangan
                teknologi yang dapat diterapkan dalam ekosistem digital.
              </p>
            </div>

          </article>


          <article class="about-faq-item">

            <h3 class="about-faq-question">
              Apakah tersedia tools dan tutorial?
            </h3>

            <div class="about-faq-answer">
              <p>
                Ya. Platform ini dapat menyediakan tools berbasis web,
                artikel, tutorial, dan materi informatif yang berkaitan
                dengan teknologi digital.
              </p>
            </div>

          </article>

        </div>

      </div>
    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="about-cta">
      <div class="about-container">

        <div class="about-cta-content">

          <h2>
            Jelajahi Dunia Teknologi Digital
          </h2>

          <p>
            Temukan berbagai pembahasan tentang AI, SEO, automation,
            digital tools, dan pengembangan website modern.
          </p>

          <a
            href="https://aimrdennis.com"
            class="about-button about-button-primary"
          >
            Kunjungi Website
          </a>

        </div>

      </div>
    </section>

  </main>

</MainLayout>
