---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../lib/site";
import "../styles/pages.css";
const pageTitle =
  "About Ai Mr Ferdy - AI, SEO & Digital Technology";

const pageDescription =
  "Mengenal Ai Mr Ferdy, platform digital yang membahas AI, SEO, automation, tools online, teknologi web, dan pengembangan produk digital modern.";
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE.url()}/about/`}
>

  <main class="page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="page-hero">

      <div class="page-container">

        <div class="page-hero-grid">

          <div class="page-hero-content">

            <span class="page-label">
              ABOUT AI MR FERDY
            </span>

            <h1>
              Menghubungkan AI, Teknologi, dan Ekosistem Digital
            </h1>

            <p>
              Ai Mr Ferdy adalah platform digital yang mengeksplorasi
              perkembangan artificial intelligence, SEO, automation,
              tools online, teknologi web, serta berbagai solusi digital
              yang relevan dengan kebutuhan internet saat ini.
            </p>

            <div class="page-actions">

              <a
                href="https://aimrdennis.com"
                class="page-button page-button-primary"
              >
                Official Website
              </a>

              <a
                href="https://news.aimrdennis.com"
                class="page-button page-button-secondary"
              >
                Latest Articles
              </a>

            </div>

          </div>


          <div class="page-hero-cards">

            <article class="page-card page-hero-card">

              <span class="page-card-label">
                TECHNOLOGY
              </span>

              <h2>
                AI & Automation
              </h2>

              <p>
                Mengeksplorasi pemanfaatan AI, automation, dan sistem
                digital untuk membantu berbagai proses menjadi lebih
                praktis dan efisien.
              </p>

            </article>


            <article class="page-card page-hero-card">

              <span class="page-card-label">
                PERFORMANCE
              </span>

              <h2>
                Fast & Clean
              </h2>

              <p>
                Mengutamakan website yang ringan, responsif, terstruktur,
                dan nyaman digunakan pada berbagai perangkat.
              </p>

            </article>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         ABOUT
    ====================================================== -->

    <section class="page-section">

      <div class="page-container">

        <div class="page-section-heading">

          <h2 class="page-section-title">
            Apa Itu Ai Mr Ferdy?
          </h2>

          <p class="page-section-description">
            Ruang digital untuk mengenal, mencoba, dan mengeksplorasi
            perkembangan teknologi modern.
          </p>

        </div>


        <div class="page-grid page-grid-3">

          <article class="page-card">

            <h3>
              AI Technology
            </h3>

            <p>
              Membahas perkembangan artificial intelligence dan
              penerapannya dalam produk, sistem, serta berbagai
              kebutuhan digital sehari-hari.
            </p>

          </article>


          <article class="page-card">

            <h3>
              SEO & Web Development
            </h3>

            <p>
              Mengeksplorasi pengembangan website yang cepat,
              responsif, terstruktur, serta memiliki fondasi
              SEO yang baik.
            </p>

          </article>


          <article class="page-card">

            <h3>
              Digital Tools
            </h3>

            <p>
              Menghadirkan berbagai utility dan tools berbasis web
              yang dapat digunakan secara praktis langsung melalui
              browser.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FOCUS
    ====================================================== -->

    <section class="page-section">

      <div class="page-container">

        <div class="page-section-heading">

          <h2 class="page-section-title">
            Fokus dan Prinsip
          </h2>

          <p class="page-section-description">
            Ai Mr Ferdy dikembangkan dengan perhatian pada kualitas,
            kesederhanaan, performa, dan relevansi teknologi.
          </p>

        </div>


        <div class="page-grid page-grid-3">

          <article class="page-card">

            <h3>
              Modern Design
            </h3>

            <p>
              Menggunakan pendekatan desain yang sederhana dan
              intuitif agar informasi maupun tools dapat digunakan
              tanpa pengalaman yang rumit.
            </p>

          </article>


          <article class="page-card">

            <h3>
              High Performance
            </h3>

            <p>
              Performa menjadi salah satu prioritas, mulai dari
              struktur halaman, kecepatan akses, hingga pengalaman
              penggunaan pada perangkat mobile.
            </p>

          </article>


          <article class="page-card">

            <h3>
              Future Ready
            </h3>

            <p>
              Terus mengikuti perkembangan AI, automation,
              web development, dan berbagai inovasi digital
              yang berkembang.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FAQ / INFORMATION
    ====================================================== -->

    <section class="page-section">

      <div class="page-container">

        <div class="page-section-heading">

          <h2 class="page-section-title">
            Tentang Platform Ai Mr Ferdy
          </h2>

          <p class="page-section-description">
            Beberapa informasi mengenai fokus dan konten yang
            tersedia di platform ini.
          </p>

        </div>


        <div class="page-faq">

          <article class="page-faq-item">

            <h3 class="page-faq-question">
              Apakah Ai Mr Ferdy membahas SEO?
            </h3>

            <div class="page-faq-answer">

              <p>
                Ya. SEO merupakan salah satu topik yang dibahas,
                terutama yang berkaitan dengan struktur website,
                performa, konten, dan pengembangan web modern.
              </p>

            </div>

          </article>


          <article class="page-faq-item">

            <h3 class="page-faq-question">
              Apa fokus utama Ai Mr Ferdy?
            </h3>

            <div class="page-faq-answer">

              <p>
                Fokusnya mencakup AI, automation, teknologi web,
                digital tools, SEO, serta berbagai perkembangan
                teknologi yang dapat diterapkan dalam ekosistem digital.
              </p>

            </div>

          </article>


          <article class="page-faq-item">

            <h3 class="page-faq-question">
              Apakah tersedia tools dan tutorial?
            </h3>

            <div class="page-faq-answer">

              <p>
                Ya. Platform ini menyediakan berbagai tools berbasis
                web, artikel, tutorial, dan materi informatif yang
                berkaitan dengan teknologi digital.
              </p>

            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="page-cta">

      <div class="page-container">

        <div class="page-cta-content">

          <h2>
            Jelajahi Dunia Teknologi Digital
          </h2>

          <p>
            Temukan berbagai pembahasan mengenai AI, SEO, automation,
            digital tools, dan pengembangan website modern.
          </p>

          <a
            href="https://aimrdennis.com"
            class="page-button page-button-primary"
          >
            Kunjungi Website
          </a>

        </div>

      </div>

    </section>

  </main>

</MainLayout>
