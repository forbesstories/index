---
import MainLayout from "../../layouts/MainLayout.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { getCollection, render } from "astro:content";
import { SITE } from "../../lib/site";

import "../../styles/tools.css";


/* =========================================================
   STATIC PATHS
========================================================= */

export async function getStaticPaths() {
  const tools = await getCollection("tools");

  return tools.map((tool) => ({
    params: {
      slug: tool.slug
    },

    props: {
      tool
    }
  }));
}


/* =========================================================
   TOOL
========================================================= */

const { tool } = Astro.props;

const { Content, headings } = await render(tool);

const tools = await getCollection("tools");


/* =========================================================
   RELATED TOOLS
========================================================= */

const relatedTools = tools
  .filter((t) => t.slug !== tool.slug)
  .slice(0, 6);


/* =========================================================
   SOFTWARE SCHEMA
========================================================= */

const softwareSchema = {
  "@context": "https://schema.org",

  "@type": "SoftwareApplication",

  name: tool.data.title,

  description: tool.data.description,

  url: SITE.url(`/tools/${tool.slug}/`),

  applicationCategory: "WebApplication",

  operatingSystem: "Any"
};


/* =========================================================
   BREADCRUMB SCHEMA
========================================================= */

const breadcrumbs = {
  "@context": "https://schema.org",

  "@type": "BreadcrumbList",

  itemListElement: [
    {
      "@type": "ListItem",

      position: 1,

      name: "Home",

      item: SITE.url("/")
    },

    {
      "@type": "ListItem",

      position: 2,

      name: "Tools",

      item: SITE.url("/tools/")
    },

    {
      "@type": "ListItem",

      position: 3,

      name: tool.data.title,

      item: SITE.url(`/tools/${tool.slug}/`)
    }
  ]
};
---

<MainLayout
  title={`${tool.data.title} | ${SITE.title}`}
  description={tool.data.description}
  slug={tool.slug}
  breadcrumbs={breadcrumbs}
  amp={SITE.url(`/tools/${tool.slug}/amp/`)}
>

  <section class="tools-page">

    <div class="container">


      <!-- =============================================
           BREADCRUMB
      ============================================== -->

      <nav
        class="breadcrumb"
        aria-label="Breadcrumb"
      >

        <a href="/">
          Home
        </a>

        <span aria-hidden="true">
          /
        </span>

        <a href="/tools/">
          Tools
        </a>

        <span aria-hidden="true">
          /
        </span>

        <span>
          {tool.data.title}
        </span>

      </nav>


      <!-- =============================================
           TOOL CONTENT
      ============================================== -->

      <article class="tool-content">


        <!-- TITLE -->

        <header class="tool-header">

          <h1>
            {tool.data.title}
          </h1>

          {
            tool.data.description && (

              <p class="tool-description">
                {tool.data.description}
              </p>

            )
          }

        </header>


        <!-- ===========================================
             TABLE OF CONTENTS
        ============================================ -->

        {
          headings.length > 0 && (

            <details class="toc">

              <summary class="toc-title">
                <span>
                  📑 Daftar Isi
                </span>

                <span
                  class="toc-toggle"
                  aria-hidden="true"
                >
                </span>

              </summary>


              <ul>

                {
                  headings.map((heading) => (

                    <li
                      class={`depth-${heading.depth}`}
                    >

                      <a
                        href={`#${heading.slug}`}
                      >
                        {heading.text}
                      </a>

                    </li>

                  ))
                }

              </ul>

            </details>

          )
        }


        <!-- ===========================================
             CONTENT
        ============================================ -->

        <div class="tool-article">

          <Content />

        </div>


      </article>


      <!-- =============================================
           RELATED TOOLS
      ============================================== -->

      <RelatedPosts
        posts={relatedTools}
        title="Tools Terkait"
        baseUrl="/tools"
      />


    </div>

  </section>


  <!-- ===============================================
       SOFTWARE APPLICATION SCHEMA
  ================================================ -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema)}
  />

</MainLayout>
