---
import MainLayout from "../../layouts/MainLayout.astro";
import { SITE } from "../../lib/site";

/* =========================================================
   LOAD ALL TOOLS
   ========================================================= */

const modules = Object.entries(
  import.meta.glob("./**/*.astro", {
    eager: true
  })
);


/* =========================================================
   BUILD TOOL LIST
   ========================================================= */

const tools = modules
  .map(([file, mod]) => {

    /*
     * Contoh:
     *
     * ./generator/emoji-text.astro
     *
     * category = generator
     * slug     = emoji-text
     */

    const match = file.match(
      /^\.\/([^/]+)\/(.+)\.astro$/
    );

    if (!match) {
      return null;
    }

    const category = match[1];
    const slug = match[2];

    /*
     * Jangan mengambil halaman category dinamis
     * atau file index.
     */

    if (
      category === "[category]" ||
      slug === "index"
    ) {
      return null;
    }

    /*
     * Metadata wajib berasal dari file tool:
     *
     * export const meta = {
     *   title: "...",
     *   description: "...",
     *   icon: "...",
     *   featured: true
     * };
     */

    if (!mod.meta) {
      return null;
    }

    return {
      ...mod.meta,

      category,

      slug,

      url:
        `/tools/${category}/${slug}/`
    };
  })
  .filter(Boolean)
  .sort((a, b) =>
    (a.title || "").localeCompare(
      b.title || "",
      "id"
    )
  );


/* =========================================================
   STATS
   ========================================================= */

const totalTools = tools.length;

const totalCategories =
  new Set(
    tools.map(tool => tool.category)
  ).size;


/* =========================================================
   SEO
   ========================================================= */

const pageUrl =
  SITE.url("/tools/");


const jsonLd = {

  "@context":
    "https://schema.org",

  "@type":
    "CollectionPage",

  name:
    `Tools | ${SITE.title}`,

  description:
    "Kumpulan AI tools dan utility online yang dapat digunakan langsung dari browser.",

  url:
    pageUrl,

  mainEntity: {

    "@type":
      "ItemList",

    numberOfItems:
      totalTools,

    itemListElement:
      tools.map((tool, index) => ({

        "@type":
          "ListItem",

        position:
          index + 1,

        name:
          tool.title,

        url:
          SITE.url(tool.url)

      }))

  }

};
---


<MainLayout
  title={`Tools | ${SITE.title}`}
  description="Kumpulan AI tools dan utility online yang dapat digunakan langsung dari browser."
>


  <section class="tools-page">


    <!-- HEADER -->

    <header class="page-header">

      <span class="tools-label">
        AI TOOLS
      </span>

      <h1>
        Tools Online
      </h1>

      <p>
        Kumpulan AI tools dan utility online
        yang dapat digunakan langsung dari browser.
      </p>

    </header>


    <!-- STATS -->

    <section
      class="tools-stats"
      aria-label="Statistik tools"
    >

      <div class="stat-item">

        <strong>
          {totalTools}
        </strong>

        <span>
          Tools
        </span>

      </div>


      <div class="stat-item">

        <strong>
          {totalCategories}
        </strong>

        <span>
          Kategori
        </span>

      </div>


      <div class="stat-item">

        <strong>
          100%
        </strong>

        <span>
          Gratis
        </span>

      </div>

    </section>


    <!-- SEARCH -->

    <div class="tools-search">

      <label
        for="toolSearch"
        class="search-label"
      >
        Cari tools
      </label>

      <input
        id="toolSearch"
        type="search"
        placeholder="Cari tools..."
        autocomplete="off"
        spellcheck="false"
      />

    </div>


    <!-- TOOLS -->

    {tools.length > 0 ? (

      <section
        class="tools-section"
        aria-labelledby="tools-title"
      >

        <div class="section-heading">

          <h2 id="tools-title">
            Semua Tools
          </h2>

          <span class="tool-count">
            {totalTools} tools
          </span>

        </div>


        <div
          id="toolsGrid"
          class="tools-grid"
        >

          {tools.map((tool) => (

            <article
              class="tool-card"
              data-search={
                `${tool.title || ""}
                 ${tool.description || ""}
                 ${tool.category || ""}`
              }
            >

              {tool.featured && (

                <span class="tool-badge">
                  HOT
                </span>

              )}


              {tool.icon && (

                <div
                  class="tool-icon"
                  aria-hidden="true"
                >
                  {tool.icon}
                </div>

              )}


              <div class="tool-category">

                {tool.category
                  .replace(/[-_]/g, " ")
                  .replace(/\b\w/g, char =>
                    char.toUpperCase()
                  )}

              </div>


              <h3>

                <a href={tool.url}>
                  {tool.title}
                </a>

              </h3>


              {tool.description && (

                <p>
                  {tool.description}
                </p>

              )}


              <a
                href={tool.url}
                class="tool-button"
                aria-label={`Buka ${tool.title}`}
              >
                Buka Tool
                <span aria-hidden="true">
                  →
                </span>
              </a>

            </article>

          ))}

        </div>


        <!-- EMPTY SEARCH -->

        <div
          id="emptyState"
          class="tools-empty"
          hidden
        >

          <strong>
            Tool tidak ditemukan
          </strong>

          <p>
            Coba gunakan kata kunci pencarian lainnya.
          </p>

        </div>

      </section>

    ) : (

      <div class="tools-empty">

        <strong>
          Belum ada tools
        </strong>

        <p>
          Belum ada file tool yang tersedia.
        </p>

      </div>

    )}


  </section>


  <!-- SEARCH SCRIPT -->

  <script>

    const searchInput =
      document.querySelector("#toolSearch");

    const cards =
      document.querySelectorAll(".tool-card");

    const emptyState =
      document.querySelector("#emptyState");


    searchInput?.addEventListener(
      "input",
      () => {

        const query =
          searchInput.value
            .toLowerCase()
            .trim();


        let visible =
          0;


        cards.forEach((card) => {

          const text =
            card.dataset.search ||
            card.textContent ||
            "";


          const match =
            text
              .toLowerCase()
              .includes(query);


          card.hidden =
            !match;


          if (match) {
            visible++;
          }

        });


        if (emptyState) {

          emptyState.hidden =
            visible !== 0;

        }

      }
    );

  </script>


  <!-- JSON-LD -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />


</MainLayout>


<style>

.tools-page {

  width:
    min(1200px, calc(100% - 32px));

  margin-inline:
    auto;

  padding:
    90px 0 50px;

}


/* =========================================================
   HEADER
   ========================================================= */

.page-header {

  max-width:
    760px;

  margin:
    0 auto 36px;

  text-align:
    center;

}


.tools-label {

  display:
    inline-block;

  margin-bottom:
    10px;

  color:
    var(--primary, #3b82f6);

  font-size:
    12px;

  font-weight:
    700;

  letter-spacing:
    .1em;

}


.page-header h1 {

  margin:
    0 0 14px;

  color:
    var(--text, #f8fafc);

  font-size:
    clamp(32px, 5vw, 48px);

  line-height:
    1.1;

}


.page-header p {

  max-width:
    650px;

  margin:
    0 auto;

  color:
    var(--soft, #94a3b8);

  font-size:
    16px;

  line-height:
    1.7;

}


/* =========================================================
   STATS
   ========================================================= */

.tools-stats {

  display:
    grid;

  grid-template-columns:
    repeat(3, 1fr);

  max-width:
    700px;

  margin:
    0 auto 32px;

  overflow:
    hidden;

  border:
    1px solid
    var(--border, rgba(255,255,255,.08));

  border-radius:
    16px;

  background:
    var(--card, rgba(15,23,42,.72));

}


.stat-item {

  padding:
    18px 12px;

  text-align:
    center;

}


.stat-item strong {

  display:
    block;

  color:
    var(--text, #f8fafc);

  font-size:
    22px;

  line-height:
    1.2;

}


.stat-item span {

  display:
    block;

  margin-top:
    5px;

  color:
    var(--soft, #94a3b8);

  font-size:
    13px;

}


/* =========================================================
   SEARCH
   ========================================================= */

.tools-search {

  max-width:
    650px;

  margin:
    0 auto 42px;

}


.search-label {

  display:
    block;

  margin-bottom:
    8px;

  color:
    var(--text, #f8fafc);

  font-size:
    14px;

  font-weight:
    600;

}


.tools-search input {

  width:
    100%;

  box-sizing:
    border-box;

  padding:
    14px 18px;

  border:
    1px solid
    var(--border, rgba(255,255,255,.08));

  border-radius:
    12px;

  outline:
    none;

  background:
    var(--card, rgba(15,23,42,.72));

  color:
    var(--text, #f8fafc);

  font:
    inherit;

}


.tools-search input::placeholder {

  color:
    var(--soft, #94a3b8);

}


.tools-search input:focus {

  border-color:
    var(--primary, #3b82f6);

  box-shadow:
    0 0 0 3px
    rgba(59,130,246,.12);

}


/* =========================================================
   SECTION
   ========================================================= */

.tools-section {

  margin-bottom:
    44px;

}


.section-heading {

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    20px;

  margin-bottom:
    20px;

}


.section-heading h2 {

  margin:
    0;

  color:
    var(--text, #f8fafc);

  font-size:
    24px;

  line-height:
    1.3;

}


.tool-count {

  color:
    var(--soft, #94a3b8);

  font-size:
    13px;

}


/* =========================================================
   GRID
   ========================================================= */

.tools-grid {

  display:
    grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap:
    20px;

}


/* =========================================================
   CARD
   ========================================================= */

.tool-card {

  position:
    relative;

  display:
    flex;

  flex-direction:
    column;

  min-width:
    0;

  padding:
    22px;

  border:
    1px solid
    var(--border, rgba(255,255,255,.08));

  border-radius:
    18px;

  background:
    var(--card, rgba(15,23,42,.72));

  transition:
    transform .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;

}


.tool-card:hover {

  transform:
    translateY(-4px);

  border-color:
    rgba(59,130,246,.4);

  box-shadow:
    0 12px 35px
    rgba(0,0,0,.18);

}


.tool-card h3 {

  margin:
    0 0 8px;

  color:
    var(--text, #f8fafc);

  font-size:
    18px;

  line-height:
    1.35;

}


.tool-card h3 a {

  color:
    inherit;

  text-decoration:
    none;

}


.tool-card h3 a:hover {

  color:
    var(--primary, #3b82f6);

}


.tool-card p {

  margin:
    0;

  color:
    var(--soft, #94a3b8);

  font-size:
    14px;

  line-height:
    1.6;

}


/* =========================================================
   CATEGORY
   ========================================================= */

.tool-category {

  margin-bottom:
    7px;

  color:
    var(--primary, #3b82f6);

  font-size:
    11px;

  font-weight:
    700;

  letter-spacing:
    .07em;

  text-transform:
    uppercase;

}


/* =========================================================
   ICON
   ========================================================= */

.tool-icon {

  width:
    48px;

  height:
    48px;

  display:
    grid;

  place-items:
    center;

  margin-bottom:
    14px;

  border-radius:
    13px;

  background:
    rgba(59,130,246,.12);

  font-size:
    24px;

}


/* =========================================================
   BUTTON
   ========================================================= */

.tool-button {

  display:
    inline-flex;

  align-items:
    center;

  gap:
    6px;

  width:
    fit-content;

  margin-top:
    16px;

  color:
    var(--primary, #3b82f6);

  font-size:
    13px;

  font-weight:
    700;

  text-decoration:
    none;

}


.tool-button:hover {

  text-decoration:
    underline;

}


/* =========================================================
   BADGE
   ========================================================= */

.tool-badge {

  position:
    absolute;

  top:
    15px;

  right:
    15px;

  padding:
    4px 8px;

  border-radius:
    6px;

  background:
    var(--primary, #3b82f6);

  color:
    #fff;

  font-size:
    10px;

  font-weight:
    700;

}


/* =========================================================
   EMPTY
   ========================================================= */

.tools-empty {

  padding:
    35px 20px;

  margin-bottom:
    40px;

  text-align:
    center;

  border:
    1px dashed
    var(--border, rgba(255,255,255,.08));

  border-radius:
    16px;

  color:
    var(--soft, #94a3b8);

}


.tools-empty[hidden] {

  display:
    none;

}


.tools-empty strong {

  display:
    block;

  margin-bottom:
    5px;

  color:
    var(--text, #f8fafc);

}


.tools-empty p {

  margin:
    0;

}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width:900px) {

  .tools-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

  }

}


@media (max-width:600px) {

  .tools-page {

    width:
      min(100%, calc(100% - 24px));

    padding:
      70px 0 35px;

  }


  .page-header h1 {

    font-size:
      32px;

  }


  .tools-stats {

    margin-bottom:
      24px;

  }


  .stat-item {

    padding:
      14px 8px;

  }


  .stat-item strong {

    font-size:
      18px;

  }


  .tools-grid {

    grid-template-columns:
      1fr;

    gap:
      14px;

  }


  .section-heading {

    align-items:
      flex-start;

  }


  .section-heading h2 {

    font-size:
      21px;

  }

}

</style>
