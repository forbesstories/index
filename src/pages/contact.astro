---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/pages.css";
---

<MainLayout
  title="Contact - Ai Mr Ferdy"
  description="Hubungi Ai Mr Ferdy untuk konsultasi digital growth, SEO strategy, dan website optimization."
>

  <main class="page-contact">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="page-contact-hero">
      <div class="page-contact-container">

        <div class="page-contact-grid">

          <div class="page-contact-intro">

            <span class="page-contact-label">
              CONTACT AI MR FERDY
            </span>

            <h1>
              Mari Diskusikan
              <span>Growth Digital</span>
              Anda
            </h1>

            <p class="page-contact-description">
              Ceritakan kebutuhan website, SEO, content strategy,
              atau pengembangan digital Anda. Kami dapat membantu
              menyusun pendekatan yang lebih terarah sesuai tujuan
              dan kondisi proyek.
            </p>

            <div class="page-contact-list">

              <div class="page-contact-item">
                <strong>Email</strong>
                <p>hello@aimrferdy.com</p>
              </div>

              <div class="page-contact-item">
                <strong>WhatsApp</strong>
                <p>+62 812-3456-7890</p>
              </div>

              <div class="page-contact-item">
                <strong>Location</strong>
                <p>Indonesia</p>
              </div>

            </div>

          </div>


          <!-- =================================================
               FORM
          ================================================== -->

          <div class="page-contact-card">

            <div class="page-contact-card-head">

              <span class="page-contact-card-label">
                GET IN TOUCH
              </span>

              <h2>
                Konsultasi Digital
              </h2>

              <p>
                Sampaikan kebutuhan Anda melalui formulir
                berikut agar pembahasan dapat dimulai
                dengan informasi yang jelas.
              </p>

            </div>


            <form class="page-contact-form">

              <div class="page-contact-form-group">

                <label for="contact-name">
                  Nama
                </label>

                <input
                  id="contact-name"
                  type="text"
                  name="name"
                  placeholder="Nama lengkap"
                  autocomplete="name"
                />

              </div>


              <div class="page-contact-form-group">

                <label for="contact-email">
                  Email
                </label>

                <input
                  id="contact-email"
                  type="email"
                  name="email"
                  placeholder="email@domain.com"
                  autocomplete="email"
                />

              </div>


              <div class="page-contact-form-group">

                <label for="contact-website">
                  Website
                </label>

                <input
                  id="contact-website"
                  type="url"
                  name="website"
                  placeholder="https://websiteanda.com"
                  autocomplete="url"
                />

              </div>


              <div class="page-contact-form-group">

                <label for="contact-message">
                  Kebutuhan
                </label>

                <textarea
                  id="contact-message"
                  name="message"
                  rows="5"
                  placeholder="Ceritakan kebutuhan digital Anda..."
                ></textarea>

              </div>


              <button
                type="submit"
                class="page-contact-button"
              >
                Kirim Konsultasi
                <span aria-hidden="true">→</span>
              </button>

            </form>

          </div>

        </div>

      </div>
    </section>


    <!-- =====================================================
         SERVICES
    ====================================================== -->

    <section class="page-contact-section">

      <div class="page-contact-container">

        <div class="page-contact-section-title">

          <span class="page-contact-label">
            SERVICES
          </span>

          <h2>
            Solusi untuk Pertumbuhan Digital
          </h2>

          <p>
            Pendekatan yang berfokus pada struktur website,
            pencarian organik, konten, dan pengalaman pengguna.
          </p>

        </div>


        <div class="page-contact-service-grid">

          <article class="page-contact-service">
            <span class="page-contact-service-number">
              01
            </span>

            <h3>
              SEO Strategy
            </h3>

            <p>
              Menyusun strategi pencarian organik melalui
              riset keyword, evaluasi website, dan roadmap
              pertumbuhan yang berbasis data.
            </p>
          </article>


          <article class="page-contact-service">
            <span class="page-contact-service-number">
              02
            </span>

            <h3>
              Technical Optimization
            </h3>

            <p>
              Membantu memperbaiki struktur website,
              technical SEO, indexing, performa, dan
              aspek teknis yang memengaruhi pengalaman pengguna.
            </p>
          </article>


          <article class="page-contact-service">
            <span class="page-contact-service-number">
              03
            </span>

            <h3>
              Content Strategy
            </h3>

            <p>
              Mengembangkan struktur konten yang lebih
              terarah untuk membangun topical relevance
              dan pertumbuhan jangka panjang.
            </p>
          </article>


          <article class="page-contact-service">
            <span class="page-contact-service-number">
              04
            </span>

            <h3>
              Conversion Optimization
            </h3>

            <p>
              Mengevaluasi user experience dan alur halaman
              agar pengunjung dapat menemukan informasi
              serta melakukan tindakan dengan lebih mudah.
            </p>
          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         PROCESS
    ====================================================== -->

    <section class="page-contact-section page-contact-section-alt">

      <div class="page-contact-container">

        <div class="page-contact-section-title">

          <span class="page-contact-label">
            WORKFLOW
          </span>

          <h2>
            Bagaimana Prosesnya?
          </h2>

          <p>
            Setiap proyek dimulai dari pemahaman kebutuhan
            sebelum masuk ke tahap analisis dan implementasi.
          </p>

        </div>


        <div class="page-contact-process-grid">

          <article class="page-contact-process">

            <div class="page-contact-process-number">
              01
            </div>

            <h3>
              Diskusi Awal
            </h3>

            <p>
              Memahami kondisi website, kebutuhan,
              target, serta tujuan yang ingin dicapai.
            </p>

          </article>


          <article class="page-contact-process">

            <div class="page-contact-process-number">
              02
            </div>

            <h3>
              Audit & Analysis
            </h3>

            <p>
              Mengevaluasi aspek teknis, konten,
              struktur website, dan peluang pengembangan.
            </p>

          </article>


          <article class="page-contact-process">

            <div class="page-contact-process-number">
              03
            </div>

            <h3>
              Strategy Planning
            </h3>

            <p>
              Menentukan prioritas dan menyusun
              roadmap berdasarkan hasil analisis.
            </p>

          </article>


          <article class="page-contact-process">

            <div class="page-contact-process-number">
              04
            </div>

            <h3>
              Execution
            </h3>

            <p>
              Menerapkan strategi yang telah disusun
              kemudian mengevaluasi perkembangan secara berkala.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FAQ
    ====================================================== -->

    <section class="page-contact-section">

      <div class="page-contact-container">

        <div class="page-contact-section-title">

          <span class="page-contact-label">
            FAQ
          </span>

          <h2>
            Pertanyaan Umum
          </h2>

          <p>
            Beberapa hal yang sering ditanyakan sebelum
            memulai pembahasan proyek.
          </p>

        </div>


        <div class="page-contact-faq-grid">

          <article class="page-contact-faq">

            <h3>
              Apakah konsultasi awal gratis?
            </h3>

            <p>
              Konsultasi awal dapat digunakan untuk memahami
              kebutuhan, kondisi proyek, dan ruang lingkup
              pembahasan sebelum menentukan langkah berikutnya.
            </p>

          </article>


          <article class="page-contact-faq">

            <h3>
              Berapa lama proses SEO?
            </h3>

            <p>
              Waktu yang diperlukan berbeda untuk setiap website.
              Faktor seperti kompetisi, kondisi teknis,
              kualitas konten, dan target pencarian dapat
              memengaruhi prosesnya.
            </p>

          </article>


          <article class="page-contact-faq">

            <h3>
              Apakah proyek website kecil bisa dibahas?
            </h3>

            <p>
              Ya. Kebutuhan website dengan skala berbeda
              tetap dapat dibahas terlebih dahulu agar solusi
              yang dipilih sesuai dengan kebutuhan proyek.
            </p>

          </article>


          <article class="page-contact-faq">

            <h3>
              Apakah tersedia laporan perkembangan?
            </h3>

            <p>
              Untuk proyek yang membutuhkan monitoring,
              perkembangan dapat dievaluasi berdasarkan
              indikator yang relevan dengan tujuan proyek.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="page-contact-cta">

      <div class="page-contact-container">

        <div class="page-contact-cta-box">

          <span class="page-contact-label">
            START A CONVERSATION
          </span>

          <h2>
            Punya Ide atau Proyek Digital?
          </h2>

          <p>
            Mari mulai dari pembahasan sederhana mengenai
            kebutuhan dan tujuan digital Anda.
          </p>

          <a
            href="mailto:hello@aimrferdy.com"
            class="page-contact-button"
          >
            Hubungi Ai Mr Ferdy
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </div>

    </section>

  </main>

</MainLayout>
