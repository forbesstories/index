---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../lib/site";
import "../styles/pages.css";

const pageTitle = `Disclaimer | ${SITE.title}`;

const pageDescription =
  "Disclaimer Ai Mr Ferdy mengenai informasi, artikel, tools, teknologi, AI, SEO, dan layanan digital yang tersedia di website.";

const canonical = `${SITE.url()}/disclaimer/`;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
>

  <main class="page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="page-hero">

      <div class="page-container">

        <div class="page-hero-content">

          <span class="page-label">
            DISCLAIMER
          </span>

          <h1>
            Disclaimer Ai Mr Ferdy
          </h1>

          <p>
            Informasi penting mengenai penggunaan konten,
            tools, layanan, dan informasi yang tersedia
            di platform Ai Mr Ferdy.
          </p>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <section class="page-section">

      <div class="page-container">

        <div class="page-legal">

          <div class="page-legal-section">

            <h2>
              Informasi Umum
            </h2>

            <p>
              Ai Mr Ferdy menyediakan berbagai informasi mengenai
              artificial intelligence, teknologi, SEO, automation,
              pengembangan website, digital tools, dan topik teknologi
              lainnya untuk tujuan informasi dan edukasi.
            </p>

            <p>
              Meskipun kami berusaha menyajikan informasi yang relevan
              dan diperbarui, tidak ada jaminan bahwa seluruh informasi
              di website selalu lengkap, akurat, atau sesuai dengan
              kondisi terbaru.
            </p>

          </div>


          <div class="page-legal-section">

            <h2>
              Penggunaan Informasi
            </h2>

            <p>
              Informasi yang tersedia di Ai Mr Ferdy dapat digunakan
              sebagai referensi awal. Pengunjung sebaiknya melakukan
              verifikasi tambahan sebelum menggunakan informasi tersebut
              untuk keputusan teknis, bisnis, finansial, atau kebutuhan
              lainnya.
            </p>

          </div>


          <div class="page-legal-section">

            <h2>
              Tools dan Teknologi
            </h2>

            <p>
              Beberapa halaman menyediakan tools online yang dapat
              digunakan langsung melalui browser. Hasil yang diberikan
              oleh tools tersebut bergantung pada input pengguna,
              metode pemrosesan, dan teknologi yang digunakan.
            </p>

            <p>
              Karena itu, hasil dari sebuah tool sebaiknya diperiksa
              kembali sebelum digunakan pada proyek atau sistem
              yang bersifat penting.
            </p>

          </div>


          <div class="page-legal-section">

            <h2>
              Tautan Eksternal
            </h2>

            <p>
              Website ini dapat memuat tautan menuju website atau
              layanan pihak ketiga. Tautan tersebut disediakan untuk
              memberikan referensi atau informasi tambahan.
            </p>

            <p>
              Ai Mr Ferdy tidak mengendalikan konten, kebijakan,
              keamanan, maupun perubahan yang dilakukan oleh website
              pihak ketiga tersebut.
            </p>

          </div>


          <div class="page-legal-section">

            <h2>
              Perubahan Konten
            </h2>

            <p>
              Konten, artikel, tools, fitur, dan informasi di website
              dapat diperbarui, diubah, atau dihapus sewaktu-waktu
              tanpa pemberitahuan sebelumnya.
            </p>

          </div>


          <div class="page-legal-section">

            <h2>
              Batas Tanggung Jawab
            </h2>

            <p>
              Penggunaan informasi dan tools yang tersedia di Ai Mr Ferdy
              sepenuhnya menjadi tanggung jawab pengguna. Kami tidak
              menjamin bahwa penggunaan seluruh konten atau tools akan
              selalu menghasilkan hasil tertentu atau bebas dari
              kesalahan.
            </p>

          </div>


          <div class="page-legal-section">

            <h2>
              Persetujuan Pengguna
            </h2>

            <p>
              Dengan mengakses dan menggunakan website Ai Mr Ferdy,
              Anda dianggap telah memahami dan menyetujui ketentuan
              yang dijelaskan dalam disclaimer ini.
            </p>

          </div>


          <div class="page-divider"></div>


          <div class="page-legal-section">

            <h2>
              Hubungi Kami
            </h2>

            <p>
              Jika Anda menemukan informasi yang perlu diperbaiki,
              memiliki pertanyaan mengenai konten, atau ingin
              menyampaikan masukan terkait website, silakan hubungi
              pengelola Ai Mr Ferdy melalui kanal komunikasi resmi
              yang tersedia di website.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="page-section">

      <div class="page-container">

        <div class="page-cta">

          <div class="page-cta-content">

            <h2>
              Jelajahi Ai Mr Ferdy
            </h2>

            <p>
              Temukan berbagai artikel, teknologi AI,
              digital tools, SEO, dan informasi teknologi
              lainnya.
            </p>

            <div class="page-actions">

              <a
                href="/"
                class="page-button page-button-primary"
              >
                Kembali ke Beranda
              </a>

              <a
                href="/tools/"
                class="page-button page-button-secondary"
              >
                Lihat Tools
              </a>

            </div>

          </div>

        </div>

      </div>

    </section>

  </main>

</MainLayout>
