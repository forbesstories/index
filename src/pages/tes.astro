ont-weight:700}.feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:24px}.feature-card{padding:24px;background:var(--surface-hover);border:1px solid var(--border);border-radius:var(--radius);transition:transform var(--transition),background var(--transition),border-color var(--transition),box-shadow var(--transition)}.feature-card:hover{transform:translateY(-4px);border-color:var(--primary);box-shadow:var(--shadow)}.feature-card h3{color:var(--primary)}.feature-card p{margin-bottom:0}.process-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:0;list-style:none;counter-reset:process}.process-list li{position:relative;margin:0;padding:18px 18px 18px 60px;background:var(--surface-hover);border:1px solid var(--border);border-radius:var(--radius);counter-increment:process}.process-list li::before{content:counter(process);position:absolute;top:50%;left:18px;display:grid;place-items:center;width:30px;height:30px;color:#fff;background:var(--primary);border-radius:50%;font-size:.9rem;font-weight:800;transform:translateY(-50%)}.faq-list{display:grid;gap:14px;margin-top:24px}.faq-item{padding:22px;background:var(--surface-hover);border:1px solid var(--border);border-radius:var(--radius);transition:background var(--transition),border-color var(--transition)}.faq-item:hover{border-color:var(--primary)}.faq-item h3{color:var(--primary)}.faq-item p{margin-bottom:0}.home-section:first-of-type{margin-top:32px}.home-section:last-child{margin-bottom:32px}@media (max-width:768px){.container-page{margin:24px auto;padding:0 16px}.home-hero{margin-top:24px;padding:42px 24px}.home-section{margin-top:24px;padding:24px}.feature-grid{grid-template-columns:1fr}.process-list{grid-template-columns:1fr}}@media (max-width:480px){.container-page{margin:16px auto;padding:0 12px}.home-hero{margin-top:16px;padding:36px 18px;border-radius:var(--radius)}.home-hero h1{font-size:2rem}.home-hero h2{font-size:1.2rem}.home-hero p{font-size:.96rem;line-height:1.75}.home-section{margin-top:16px;padding:20px 16px;border-radius:var(--radius)}.home-section h2{font-size:1.4rem}.home-section h3{font-size:1.08rem}.home-section p{font-size:.96rem;line-height:1.75}.feature-card{padding:18px}.faq-item{padding:18px}.highlight-text{padding:16px;font-size:1rem!important}.process-list li{padding:16px 14px 16px 54px}}
	
	
