 footer{padding:55px 0 24px;color:var(--text);background:var(--footer);border-top:1px solid var(--footer-border)}.footergrid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:35px}.footer-title{margin:0 0 14px;color:var(--text);font-size:18px;font-weight:700;line-height:1.4}.footer-description{margin:0;max-width:520px;color:var(--text-secondary);line-height:1.8}.footergrid a{display:block;width:max-content;max-width:100%;margin:8px 0;color:var(--text-secondary);text-decoration:none;transition:color var(--transition)}.footergrid a:hover{color:var(--primary)}.copy{margin:34px auto 0;padding-top:18px;color:var(--text-secondary);border-top:1px solid var(--footer-border);text-align:center;font-size:14px;line-height:1.6}@media(max-width:900px){.footergrid{grid-template-columns:repeat(2,1fr);gap:25px}.footergrid>div:first-child{grid-column:1/-1}}@media(max-width:560px){.footergrid{grid-template-columns:1fr}.footergrid>div:first-child{grid-column:auto}}
 
	
