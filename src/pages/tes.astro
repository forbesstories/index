}

/* =====================================
   RESET
===================================== */
*{margin:0;padding:0;box-sizing:border-box}html{min-height:100%;background:var(--bg);scroll-behavior:smooth}body{min-height:100vh;font-family:Inter,Arial,sans-serif;color:var(--text);background:radial-gradient(circle at 15% 0%,rgb(26 115 232 / .13),transparent 35%),var(--bg);transition:background var(--transition),color var(--transition)}a{color:inherit;text-decoration:none}

