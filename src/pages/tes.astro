.header{position:sticky;top:0;z-index:1000;background:var(--bg);border-bottom:1px solid var(--border);backdrop-filter:blur(20px)}.header-wrap{max-width:1200px;height:60px;min-height:60px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between}.header-logo{color:var(--text);font-size:1.5rem;font-weight:700;text-decoration:none}.header-logo span{color:var(--primary)}.nav{display:flex;align-items:center;gap:32px}.nav a{color:var(--text-secondary);transition:color var(--transition)}.nav a:hover{color:var(--text)}.theme-toggle{width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:50%;cursor:pointer}.theme-toggle:hover{background:var(--surface-hover)}.theme-toggle svg{width:22px;height:22px}.sun{display:none}html[data-theme="dark"] .moon{display:none}html[data-theme="dark"] .sun{display:block}.menu-toggle{display:none;width:44px;height:44px;color:var(--text);background:none;border:none;font-size:28px;cursor:pointer}

