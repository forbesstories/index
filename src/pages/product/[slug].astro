---
import ProductLayout from '../../layouts/ProductLayout.astro';

import { getCollection } from 'astro:content';

export async function getStaticPaths() {

  const products =
    await getCollection('product');

  return products.map(product => ({
    params: {
      slug: product.slug
    },

    props: {
      product
    }
  }));
}

const { product } = Astro.props;

const { Content } =
  await product.render();
---

<ProductLayout
  title={`${product.data.title} | AI PRINT`}
  description={product.data.description}
  image={product.data.image}
  product={product.data}
>

<section class="product-layout">

  <aside class="gallery">

    {
      (
        product.data.gallery ||
        [product.data.image]
      ).map((img,index)=>(

        <div
          class={`thumb ${index===0?'active':''}`}
        >

          <img
            src={img}
            alt={product.data.title}
          />

        </div>

      ))
    }

  </aside>

  <section class="preview">

    <img
      id="mainImage"
      src={product.data.image}
      alt={product.data.title}
    />

  </section>

  <aside class="product-info">

    <h1>
      {product.data.title}
    </h1>

    <div class="seller">
      Designed and sold by AI PRINT
    </div>

    <div class="price-wrap">

      <div class="price">
        {product.data.price}
      </div>

      {
        product.data.oldPrice && (
          <div class="old-price">
            {product.data.oldPrice}
          </div>
        )
      }

    </div>

    <div class="label">
      Category
    </div>

    <div class="options">
      <button class="active-btn">
        {product.data.category}
      </button>
    </div>

    <div class="label">
      Size
    </div>

    <div class="options">
      <button>S</button>
      <button>M</button>
      <button class="active-btn">L</button>
      <button>XL</button>
      <button>2XL</button>
    </div>

    <button class="cart-btn">
      ADD TO CART
    </button>

  </aside>

</section>

<section class="description-section">

  <div class="description-box">

    <article class="content">
      <Content />
    </article>

  </div>

</section>

<style>
.product-layout{
display:grid;
grid-template-columns:110px 1fr 420px;
gap:30px;
align-items:start;
}

.gallery{
display:flex;
flex-direction:column;
gap:14px;
}

.thumb{
background:#fff;
padding:6px;
border-radius:22px;
border:2px solid transparent;
box-shadow:var(--shadow);
cursor:pointer;
}

.thumb.active{
border-color:var(--primary);
}

.preview,
.product-info,
.description-box{
background:#fff;
border-radius:32px;
box-shadow:var(--shadow);
}

.preview{
padding:40px;
display:flex;
align-items:center;
justify-content:center;
min-height:720px;
}

.preview img{
max-width:600px;
}

.product-info{
padding:34px;
position:sticky;
top:110px;
}

.product-info h1{
font-size:38px;
line-height:1.1;
}

.seller{
margin-top:10px;
color:var(--muted);
}

.price-wrap{
display:flex;
align-items:center;
gap:14px;
margin:24px 0;
}

.price{
font-size:48px;
font-weight:900;
}

.old-price{
text-decoration:line-through;
color:#999;
}

.label{
margin:28px 0 12px;
font-weight:700;
}

.options{
display:flex;
flex-wrap:wrap;
gap:10px;
}

.options button{
padding:12px 18px;
border-radius:14px;
border:1px solid var(--border);
background:#fff;
cursor:pointer;
}

.active-btn{
background:var(--dark)!important;
color:#fff;
border-color:var(--dark)!important;
}

.cart-btn{
width:100%;
margin-top:30px;
padding:18px;
border:none;
border-radius:18px;
background:linear-gradient(135deg,#5865f2,#7c3aed);
color:#fff;
font-size:18px;
font-weight:900;
cursor:pointer;
}

.description-section{
margin-top:60px;
}

.description-box{
padding:40px;
line-height:1.9;
color:#555;
}

.content h1,
.content h2,
.content h3{
margin-bottom:18px;
color:var(--dark);
}

.content p{
margin-bottom:18px;
}

.content ul{
padding-left:22px;
margin-bottom:18px;
}

@media(max-width:1200px){

.product-layout{
grid-template-columns:1fr;
}

.gallery{
flex-direction:row;
}

.product-info{
position:relative;
top:0;
}

}

@media(max-width:768px){

.preview{
min-height:auto;
padding:20px;
}

.product-info{
padding:24px;
}

.product-info h1{
font-size:30px;
}

}
</style>

<script>
const thumbs=document.querySelectorAll('.thumb');
const mainImage=document.getElementById('mainImage');

thumbs.forEach(thumb=>{
  thumb.addEventListener('click',()=>{
    thumbs.forEach(t=>t.classList.remove('active'));

    thumb.classList.add('active');

    mainImage.src=
      thumb.querySelector('img').src;
  });
});
</script>

</ProductLayout>
