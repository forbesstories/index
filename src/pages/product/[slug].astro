---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('product');

  return products.map((product) => ({
    params: {
      slug: product.slug
    },
    props: {
      product
    }
  }));
}

const { product } = Astro.props;

const { Content } = await product.render();

const allProducts = await getCollection('product');

const relatedProducts = allProducts
  .filter(
    (p) =>
      p.slug !== product.slug &&
      p.data.category === product.data.category
  )
  .slice(0, 4);

const productImage =
  product.data.image?.trim() ||
  `/api/og/${product.slug}.svg`;

const galleryImages =
  product.data.gallery?.filter((img) => img?.trim()).length
    ? product.data.gallery.filter((img) => img?.trim())
    : [productImage];

const productTitle = product.data.title;
const productDescription = product.data.description;
---

<MainLayout
  title={`${productTitle} | AI Mr Ferdy`}
  description={productDescription}
  canonical={`/product/${product.slug}/`}
>

<main class="container-page">

<nav class="product-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>›</span>
    <a href="/product/">Produk</a>
    <span>›</span>
    <span class="product-breadcrumb__current">{productTitle}</span>
</nav>


<div class="product-layout">

    <section class="content">

      <div class="gallery-card">

        <div class="main-image">

          <button
            type="button"
            class="image-arrow prev"
            id="prevImage"
            aria-label="Previous image"
          >
            ‹
          </button>

          <img
            id="mainImage"
            src={productImage}
            alt={productTitle}
          />

          <button
            type="button"
            class="image-arrow next"
            id="nextImage"
            aria-label="Next image"
          >
            ›
          </button>

          <div class="image-counter" id="imageCounter">
            1 / {galleryImages.length}
          </div>

        </div>


        <div class="thumbnail-wrap">

          <button
            type="button"
            class="thumbnail-arrow left"
            id="thumbLeft"
            aria-label="Previous thumbnails"
          >
            ‹
          </button>

          <div class="thumbnails" id="thumbnails">

            {
              galleryImages.map((img, index) => (
                <button
                  type="button"
                  class={`thumbnail ${index === 0 ? 'active' : ''}`}
                  data-index={index}
                >
                  <img
                    src={img}
                    alt={`${productTitle} image ${index + 1}`}
                  />
                </button>
              ))
            }

          </div>

          <button
            type="button"
            class="thumbnail-arrow right"
            id="thumbRight"
            aria-label="Next thumbnails"
          >
            ›
          </button>

        </div>

      </div>


      <section class="description-card" id="description">

        <h2 class="description-title">
          {productTitle}
        </h2>

        <article>
          <Content />
        </article>

      </section>


      <section class="accordion" id="details">

        <div class="accordion-item">

          <button
            class="accordion-button"
            type="button"
          >
            <span>Product information</span>
            <span class="accordion-icon">+</span>
          </button>

          <div class="accordion-content">

            <p>
              {productDescription}
            </p>

            {
              product.data.category && (
                <p>
                  Category: {product.data.category}
                </p>
              )
            }

          </div>

        </div>


        <div class="accordion-item">

          <button
            class="accordion-button"
            type="button"
          >
            <span>Product details</span>
            <span class="accordion-icon">+</span>
          </button>

          <div class="accordion-content">

            <p>
              Produk {productTitle} tersedia melalui platform AI Mr Ferdy
              dengan informasi produk yang dapat disesuaikan melalui data
              Markdown.
            </p>

          </div>

        </div>


        <div class="accordion-item">

          <button
            class="accordion-button"
            type="button"
          >
            <span>Category</span>
            <span class="accordion-icon">+</span>
          </button>

          <div class="accordion-content">

            <p>
              {product.data.category}
            </p>

          </div>

        </div>


        <div
          class="accordion-item"
          id="shipping"
        >

          <button
            class="accordion-button"
            type="button"
          >
            <span>Shipping & Returns</span>
            <span class="accordion-icon">+</span>
          </button>

          <div class="accordion-content">

            <p>
              Shipping and return information can be displayed here.
            </p>

          </div>

        </div>

      </section>

    </section>


    <aside class="sidebar">

      <div class="product-card">

        <div class="vendor">
          AI Mr Ferdy
        </div>

        <h1 class="product-title">
          {productTitle}
        </h1>


        <div class="rating">

          <span class="stars">
            ★★★★★
          </span>

          <span class="reviews">
            Customer reviews
          </span>

        </div>


        <div class="price">
          {product.data.price}
        </div>


        <div class="short-description">
          {productDescription}
        </div>


        <div class="stock">

          <span class="stock-dot"></span>

          In stock

        </div>


        <div class="divider"></div>


        <div class="option-title">
          Category
        </div>

        <button
          type="button"
          class="option"
        >
          {product.data.category}
        </button>


        <div class="buy">

          <div class="buy-row">

            <div class="quantity">

              <button
                type="button"
                id="minus"
                aria-label="Decrease quantity"
              >
                −
              </button>

              <input
                id="quantity"
                type="number"
                min="1"
                value="1"
                aria-label="Quantity"
              />

              <button
                type="button"
                id="plus"
                aria-label="Increase quantity"
              >
                +
              </button>

            </div>


            <button
              type="button"
              class="add-cart"
            >
              Add to cart
            </button>

          </div>


          <button
            type="button"
            class="buy-now"
          >
            Buy it now
          </button>

        </div>


        <div class="benefits">

          <div class="benefit">
            <span class="benefit-icon">✓</span>
            Fast shipping
          </div>

          <div class="benefit">
            <span class="benefit-icon">✓</span>
            Secure checkout
          </div>

          <div class="benefit">
            <span class="benefit-icon">✓</span>
            Quality performance parts
          </div>

        </div>


        <div class="side-links">

          <div class="side-title">
            Product
          </div>

          <a
            href="#description"
            class="side-link"
          >
            <span>Description</span>
            <span>→</span>
          </a>

          <a
            href="#details"
            class="side-link"
          >
            <span>Details</span>
            <span>→</span>
          </a>

          <a
            href="#shipping"
            class="side-link"
          >
            <span>Shipping</span>
            <span>→</span>
          </a>

        </div>

      </div>

    </aside>

</div>


{
  relatedProducts.length > 0 && (

    <section class="related-products">

      <div class="related-products__head">

        <div>

          <span class="related-products__label">
            Rekomendasi
          </span>

          <h2>
            Produk Terkait
          </h2>

          <p>
            Pilihan produk lain yang mungkin cocok untuk Anda.
          </p>

        </div>

        <a
          href="/product/"
          class="related-products__all"
        >
          Lihat Semua →
        </a>

      </div>


      <div class="related-products__grid">

        {
          relatedProducts.map((relatedProduct) => {

            const relatedImage =
              relatedProduct.data.image?.trim() ||
              `/api/og/${relatedProduct.slug}.svg`;

            return (

              <a
                href={`/product/${relatedProduct.slug}/`}
                class="related-product"
              >

                <div class="related-product__image">

                  <img
                    src={relatedImage}
                    alt={relatedProduct.data.title}
                    loading="lazy"
                  />

                  {
                    relatedProduct.data.badge && (
                      <span class="related-product__badge">
                        {relatedProduct.data.badge}
                      </span>
                    )
                  }

                </div>


                <div class="related-product__body">

                  <h3>
                    {relatedProduct.data.title}
                  </h3>


                  <div class="related-product__rating">

                    <span>
                      ★★★★★
                    </span>

                    <small>
                      4.8
                    </small>

                  </div>


                  <div class="related-product__price">
                    {relatedProduct.data.price}
                  </div>


                  {
                    relatedProduct.data.oldPrice && (
                      <div class="related-product__old">
                        {relatedProduct.data.oldPrice}
                      </div>
                    )
                  }

                </div>

              </a>

            );

          })
        }

      </div>

    </section>

  )
}

</main>


<script>
const mainImage = document.querySelector('#mainImage');
const thumbs = document.querySelectorAll('.thumbnail');
const imageCounter = document.querySelector('#imageCounter');

const prevImage = document.querySelector('#prevImage');
const nextImage = document.querySelector('#nextImage');

const quantity = document.querySelector('#quantity');
const minus = document.querySelector('#minus');
const plus = document.querySelector('#plus');

let index = 0;

function show(n) {

  if (!thumbs.length) return;

  index = (n + thumbs.length) % thumbs.length;

  const image = thumbs[index].querySelector('img');

  if (!image || !mainImage) return;

  mainImage.src = image.src;

  imageCounter.textContent =
    `${index + 1} / ${thumbs.length}`;

  thumbs.forEach((thumb, i) => {
    thumb.classList.toggle(
      'active',
      i === index
    );
  });

}

thumbs.forEach((thumb) => {

  thumb.addEventListener('click', () => {

    show(
      Number(thumb.dataset.index)
    );

  });

});


prevImage?.addEventListener(
  'click',
  () => show(index - 1)
);


nextImage?.addEventListener(
  'click',
  () => show(index + 1)
);


minus?.addEventListener(
  'click',
  () => {

    if (!quantity) return;

    quantity.value =
      Math.max(
        1,
        Number(quantity.value || 1) - 1
      );

  }
);


plus?.addEventListener(
  'click',
  () => {

    if (!quantity) return;

    quantity.value =
      Number(quantity.value || 1) + 1;

  }
);


document
  .querySelectorAll('.accordion-button')
  .forEach((button) => {

    button.addEventListener(
      'click',
      () => {

        button
          .parentElement
          .classList
          .toggle('open');

      }
    );

  });
</script>

</MainLayout>
