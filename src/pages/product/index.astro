---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('product');

const featuredProducts = products
  .filter(product => product.data.featured)
  .map(product => {
    const displayImage =
      product.data.image?.trim()
      || product.data.gallery?.find(img => img?.trim())
      || `/api/og/${product.slug}.svg`;

    return {
      ...product,
      displayImage
    };
  });
---

<MainLayout
  title="Products | AI PRINT"
  description="Browse premium POD marketplace products."
>

<section class="hero">

  <div class="hero-content">

    <span class="badge">
      PREMIUM POD MARKETPLACE
    </span>

    <h1>
      Discover Modern
      <br />
      Print-On-Demand Designs
    </h1>

    <p>
      Ultra fast Astro ecommerce storefront with
      modern UI, responsive layouts, and SEO
      optimized architecture.
    </p>

  </div>

</section>

<section class="products-section">

  <div class="section-head">

    <div>

      <h2>
        Featured Products
      </h2>

      <p>
        Trending marketplace designs
      </p>

    </div>

    <div class="filters">

      <button class="active">
        Trending
      </button>

      <button>
        Latest
      </button>

      <button>
        Popular
      </button>

    </div>

  </div>

  <div class="products-grid">

    {
      featuredProducts.map(product => (

        <a
          href={`/product/${product.slug}`}
          class="card"
        >

          <div class="card-image">

            <img
              src={product.displayImage}
              alt={product.data.title}
              loading="lazy"
            />

          </div>

          <div class="card-body">

            <div class="card-top">

              <span class="tag">
                FEATURED
              </span>

              <span class="category">
                {product.data.category}
              </span>

            </div>

            <h2>
              {product.data.title}
            </h2>

            <p class="desc">
              {product.data.description}
            </p>

            <div class="price-wrap">

              <span class="price">
                {product.data.price}
              </span>

              {
                product.data.oldPrice && (
                  <span class="old-price">
                    {product.data.oldPrice}
                  </span>
                )
              }

            </div>

          </div>

        </a>

      ))
    }

  </div>

</section>

</MainLayout>
