---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../lib/site";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const tools = await getCollection("tools");
const products = await getCollection("product");

/* ================================
   LATEST ARTICLES
================================ */

const latestPosts = [...posts]
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
  )
  .slice(0, 3);

/* ================================
   POPULAR ARTICLES
================================ */

const popularPosts =
  posts.filter((post) => post.data.popular).length > 0
    ? posts
        .filter((post) => post.data.popular)
        .slice(0, 3)
    : posts.slice(0, 3);

/* ================================
   POPULAR TOOLS
================================ */

const popularTools =
  tools.filter((tool) => tool.data.popular).length > 0
    ? tools
        .filter((tool) => tool.data.popular)
        .slice(0, 3)
    : tools.slice(0, 3);

/* ================================
   POPULAR PRODUCTS
================================ */

const popularProducts =
  products.filter((product) => product.data.popular).length > 0
    ? products
        .filter((product) => product.data.popular)
        .slice(0, 3)
    : products.slice(0, 3);

/* ================================
   SEO
================================ */

const pageTitle =
  "AI Mr Ferdy | Platform AI Indonesia untuk Produktivitas Digital";

const pageDescription =
  "AI Mr Ferdy adalah platform AI Indonesia yang menghadirkan tools, teknologi digital, SEO, otomasi, dan solusi produktivitas modern dalam satu ekosistem.";
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
  isHome={true}
  pageCSS={["home"]}
>

  <!-- =================================
       HERO
  ================================== -->

  <section class="hero">
    <div class="hero-container">

      <div class="hero-content">

        <span class="hero-badge">
          Website Resmi
        </span>

        <h1>
          AI Mr Ferdy
        </h1>

        <h2 class="hero-subtitle">
          Platform AI Indonesia untuk produktivitas,
          konten, SEO, dan otomasi digital.
        </h2>

        <p class="hero-description">
          <strong>AI Mr Ferdy</strong> merupakan platform digital
          yang menggabungkan teknologi kecerdasan buatan,
          AI tools, SEO, otomasi, dan berbagai solusi digital
          untuk membantu pekerjaan menjadi lebih praktis,
          efisien, dan terarah.
        </p>

        <div class="hero-buttons">

          <a
            href="https://ai.termsofuse.workers.dev/"
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Gunakan AI Mr Ferdy
          </a>

          <a
            href="/about/"
            class="btn btn-outline"
          >
            Tentang AI Mr Ferdy
          </a>

        </div>

        <div class="hero-features">

          <div class="feature">
            <p class="feature-title">
              AI Tools
            </p>

            <p>
              Kumpulan tools berbasis AI untuk membantu
              berbagai kebutuhan digital.
            </p>
          </div>

          <div class="feature">
            <p class="feature-title">
              SEO & Automation
            </p>

            <p>
              Solusi untuk pengelolaan website,
              optimasi SEO, dan alur kerja digital.
            </p>
          </div>

          <div class="feature">
            <p class="feature-title">
              Ekosistem Digital
            </p>

            <p>
              Satu tempat untuk menemukan tools,
              artikel, dan produk digital.
            </p>
          </div>

        </div>

      </div>

      <div class="hero-image">

        <div class="glass-card">

          <img
            src="https://aimrferdy.com/aimrferdy.png"
            fetchpriority="high"
            width="640"
            height="640"
            alt="AI Mr Ferdy, platform AI Indonesia"
          />

        </div>

        <div class="floating-card floating-card-top">

          <p class="floating-title">
            AI Platform
          </p>

          <p>
            Modern • Cepat • Andal
          </p>

        </div>

        <div class="floating-card floating-card-bottom">

          <p class="floating-title">
            Website Resmi
          </p>

          <p>
            AI Mr Ferdy Indonesia
          </p>

        </div>

      </div>

    </div>

    <div class="hero-wave"></div>
  </section>


  <!-- =================================
       ABOUT
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <h2 class="section-title">
          Mengenal AI Mr Ferdy
        </h2>

        <p class="section-desc">
          AI Mr Ferdy adalah platform teknologi yang
          menghadirkan berbagai solusi berbasis kecerdasan
          buatan untuk kebutuhan digital sehari-hari.
        </p>

      </div>

      <div class="content-card">

        <p>
          Melalui satu ekosistem, pengguna dapat menemukan
          AI tools, informasi mengenai SEO, otomasi digital,
          pembuatan konten, artikel teknologi, hingga produk
          digital yang dikembangkan untuk mendukung aktivitas
          online.
        </p>

        <p>
          Fokusnya bukan sekadar menyediakan teknologi,
          tetapi membuat teknologi tersebut lebih mudah
          dipahami dan digunakan dalam pekerjaan nyata.
        </p>

      </div>

    </div>

  </section>


  <!-- =================================
       ECOSYSTEM
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <h2 class="section-title">
          Ekosistem AI & Teknologi Digital
        </h2>

        <p class="section-desc">
          Jelajahi berbagai bagian utama dari ekosistem
          AI Mr Ferdy, mulai dari website hingga tools dan
          artikel teknologi.
        </p>

      </div>

      <div class="content-grid">

        <article class="content-card">

          <span class="card-label">
            Website
          </span>

          <h3>
            Official Website
          </h3>

          <p>
            Pusat informasi dan berbagai layanan digital
            yang berkaitan dengan AI Mr Ferdy.
          </p>

          <a
            href="/"
            class="btn btn-primary"
          >
            Buka Website
          </a>

        </article>


        <article class="content-card">

          <span class="card-label">
            Articles
          </span>

          <h3>
            News & Articles
          </h3>

          <p>
            Bacaan seputar AI, SEO, otomasi, teknologi,
            dan perkembangan dunia digital.
          </p>

          <a
            href="/blog/"
            class="btn btn-primary"
          >
            Baca Artikel
          </a>

        </article>


        <article class="content-card">

          <span class="card-label">
            Tools
          </span>

          <h3>
            AI Tools
          </h3>

          <p>
            Berbagai utilitas online dan tools digital
            untuk membantu pekerjaan lebih efisien.
          </p>

          <a
            href="/tools/"
            class="btn btn-primary"
          >
            Lihat Tools
          </a>

        </article>

      </div>

    </div>

  </section>


  <!-- =================================
       SERVICES
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <h2 class="section-title">
          AI & Digital Services
        </h2>

        <p class="section-desc">
          Teknologi AI Mr Ferdy dikembangkan untuk berbagai
          kebutuhan digital, mulai dari eksperimen AI hingga
          pengembangan website dan sistem yang lebih modern.
        </p>

      </div>

      <div class="content-grid">

        <article class="content-card">

          <h3>
            AI Projects
          </h3>

          <p>
            Eksplorasi aplikasi AI, sistem cerdas,
            pemrosesan bahasa, dan otomasi workflow
            untuk kebutuhan digital.
          </p>

        </article>

        <article class="content-card">

          <h3>
            SEO Systems
          </h3>

          <p>
            Pendekatan teknis untuk membangun website
            yang terstruktur, mudah ditemukan mesin pencari,
            dan siap dikembangkan.
          </p>

        </article>

        <article class="content-card">

          <h3>
            Modern UI
          </h3>

          <p>
            Antarmuka yang sederhana, responsif,
            cepat, dan nyaman digunakan pada berbagai
            ukuran perangkat.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- =================================
       POPULAR TOOLS
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <h2 class="section-title">
          AI Tools Pilihan
        </h2>

        <p class="section-desc">
          Beberapa tools yang dapat membantu menyelesaikan
          pekerjaan digital dengan lebih praktis.
        </p>

      </div>

      <div class="blog-grid">

        {
          popularTools.map((tool) => (

            <article class="blog-card">

              <a
                href={`/tools/${tool.slug}/`}
                class="blog-card-link"
              >

                <div class="blog-card-image">

                  <img
                    src={SITE.url(`/api/og/${tool.slug}.svg`)}
                    alt={tool.data.title}
                    loading="lazy"
                    width="1200"
                    height="630"
                  />

                </div>

                <div class="blog-card-content">

                  <span class="card-label">
                    AI Tool
                  </span>

                  <h3>
                    {tool.data.title}
                  </h3>

                  {
                    tool.data.description && (
                      <p>
                        {tool.data.description}
                      </p>
                    )
                  }

                  <span class="readmore">
                    Buka Tool →
                  </span>

                </div>

              </a>

            </article>

          ))
        }

      </div>

    </div>

  </section>


  <!-- =================================
       LATEST ARTICLES
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <h2 class="section-title">
          Artikel Terbaru
        </h2>

        <p class="section-desc">
          Informasi dan pembahasan terbaru mengenai AI,
          SEO, teknologi, dan dunia digital.
        </p>

      </div>

      <div class="blog-grid">

        {
          latestPosts.map((post) => (

            <article class="blog-card">

              <a
                href={`/blog/${post.slug}/`}
                class="blog-card-link"
              >

                <div class="blog-card-image">

                  <img
                    src={SITE.url(`/api/og/${post.slug}.svg`)}
                    alt={post.data.title}
                    loading="lazy"
                    width="1200"
                    height="630"
                  />

                </div>

                <div class="blog-card-content">

                  <div class="blog-card-meta">
                    {post.data.date}
                  </div>

                  <h3>
                    {post.data.title}
                  </h3>

                  {
                    post.data.description && (
                      <p>
                        {post.data.description}
                      </p>
                    )
                  }

                  <span class="readmore">
                    Baca Artikel →
                  </span>

                </div>

              </a>

            </article>

          ))
        }

      </div>

    </div>

  </section>


  <!-- =================================
       PRODUCTS
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <h2 class="section-title">
          Produk Digital
        </h2>

        <p class="section-desc">
          Pilihan produk digital yang dikembangkan
          untuk mendukung kebutuhan pengguna.
        </p>

      </div>

      <div class="blog-grid">

        {
          popularProducts.map((product) => (

            <article class="blog-card">

              <a
                href={`/product/${product.slug}/`}
                class="blog-card-link"
              >

                <div class="blog-card-image">

                  <img
                    src={SITE.url(`/api/og/${product.slug}.svg`)}
                    alt={product.data.title}
                    loading="lazy"
                    width="1200"
                    height="630"
                  />

                </div>

                <div class="blog-card-content">

                  <span class="card-label">
                    Digital Product
                  </span>

                  <h3>
                    {product.data.title}
                  </h3>

                  {
                    product.data.description && (
                      <p>
                        {product.data.description}
                      </p>
                    )
                  }

                  {
                    product.data.price && (
                      <div class="blog-card-meta">
                        {product.data.price}
                      </div>
                    )
                  }

                  <span class="readmore">
                    Lihat Produk →
                  </span>

                </div>

              </a>

            </article>

          ))
        }

      </div>

    </div>

  </section>


  <!-- =================================
       FAQ
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <h2 class="section-title">
          Pertanyaan Umum tentang AI Mr Ferdy
        </h2>

        <p class="section-desc">
          Berikut beberapa pertanyaan yang sering muncul
          mengenai platform, tools, dan layanan AI Mr Ferdy.
        </p>

      </div>

      <div class="faq-list">

        <details class="faq-item">

          <summary class="faq-question">
            Apa itu AI Mr Ferdy?
            <span class="faq-icon"></span>
          </summary>

          <div class="faq-answer">

            <p>
              AI Mr Ferdy adalah platform digital yang
              menyediakan berbagai tools berbasis AI,
              informasi teknologi, solusi otomasi,
              SEO, dan produk digital untuk membantu
              aktivitas online menjadi lebih praktis.
            </p>

          </div>

        </details>


        <details class="faq-item">

          <summary class="faq-question">
            Apa saja yang tersedia di AI Mr Ferdy?
            <span class="faq-icon"></span>
          </summary>

          <div class="faq-answer">

            <p>
              Pengguna dapat menemukan AI tools,
              artikel mengenai teknologi dan SEO,
              berbagai solusi otomasi, serta produk
              digital yang dikembangkan dalam ekosistem
              AI Mr Ferdy.
            </p>

          </div>

        </details>


        <details class="faq-item">

          <summary class="faq-question">
            Apakah AI Mr Ferdy menyediakan tools gratis?
            <span class="faq-icon"></span>
          </summary>

          <div class="faq-answer">

            <p>
              Ya. Beberapa tools tersedia untuk digunakan
              secara gratis. Layanan atau fitur tertentu
              dapat memiliki pilihan premium dengan
              kemampuan tambahan.
            </p>

          </div>

        </details>


        <details class="faq-item">

          <summary class="faq-question">
            Apakah AI Mr Ferdy dapat digunakan melalui smartphone?
            <span class="faq-icon"></span>
          </summary>

          <div class="faq-answer">

            <p>
              Ya. Website dan tools dirancang agar dapat
              digunakan melalui smartphone, tablet,
              maupun komputer dengan tampilan yang
              menyesuaikan ukuran layar.
            </p>

          </div>

        </details>


        <details class="faq-item">

          <summary class="faq-question">
            Di mana website resmi AI Mr Ferdy?
            <span class="faq-icon"></span>
          </summary>

          <div class="faq-answer">

            <p>
              Website utama AI Mr Ferdy dapat diakses
              melalui domain resmi
              <strong>aimrferdy.com</strong>.
              Di dalamnya tersedia informasi, artikel,
              tools, dan produk digital yang berkaitan
              dengan ekosistem AI Mr Ferdy.
            </p>

          </div>

        </details>

      </div>

    </div>

  </section>


  <!-- =================================
       CTA
  ================================== -->

  <section class="cta">

    <div class="container-page">

      <div class="cta-content">

        <h2>
          Jelajahi AI Tools dan Teknologi Digital
        </h2>

        <p>
          Temukan berbagai tools, artikel, dan solusi
          digital yang dapat membantu aktivitas online
          menjadi lebih sederhana.
        </p>

        <a
          href="https://ai.termsofuse.workers.dev/"
          class="btn btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Mulai Menjelajah
        </a>

      </div>

    </div>

  </section>

</MainLayout>
