---
import { SITE } from "../lib/site";

const linkalt = "/";

const blogItems = [
  { href: "/blog", label: "All Articles" },
  { href: "/blog/ai", label: "AI" },
  { href: "/blog/gaming", label: "Gaming" },
  { href: "/blog/technology", label: "Technology" },
];

const toolItems = [
  { href: "/tools", label: "All Tools" },
  { href: "/tools/ai", label: "AI Tools" },
  { href: "/tools/gaming", label: "Gaming Tools" },
  { href: "/tools/android", label: "Android Tools" },
];

const productItems = [
  { href: "/product", label: "All Products" },
  { href: "/product/roboragma", label: "Roboragma APK" },
  { href: "/product/ai-assistant", label: "AI Assistant" },
  { href: "/product/gamer-assistant", label: "Gamer Assistant" },
];

const menus = [
  { label: "Blog", items: blogItems },
  { label: "Tools", items: toolItems },
  { label: "Product", items: productItems },
];
---

<header class="header">
  <div class="header-wrap">

    <!-- MOBILE MENU -->
    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="nav"
    >
      ☰
    </button>

    <!-- LOGO -->
    <a
      href={linkalt}
      class="header-logo"
      aria-label="AI Mr Ferdy"
    >
      AI<span> Mr Ferdy</span>
    </a>

    <!-- NAVIGATION -->
    <nav
      class="nav"
      id="nav"
      aria-label="Main navigation"
    >

      <a href="/">Home</a>

      <a href="https://aimrferdy.com">Ai Mr Ferdy</a>

      {
        menus.map((menu) => (
          <div class="dropdown">

            <button
              class="drop-btn"
              type="button"
              aria-expanded="false"
            >
              {menu.label}

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>

            <div class="drop-menu">

              {
                menu.items.map((item) => (
                  <a href={item.href}>
                    {item.label}
                  </a>
                ))
              }

            </div>

          </div>
        ))
      }

      <a href="/about">About</a>

    </nav>

    <!-- HEADER ACTIONS -->
    <div class="header-actions">

      <!-- CART -->
      <a
        href="/cart"
        class="cart-btn"
        aria-label="Shopping cart"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="9" cy="20" r="1"/>
          <circle cx="18" cy="20" r="1"/>
          <path d="M3 4h2l2.4 11.5a2 2 0 0 0 2 1.5h7.7a2 2 0 0 0 2-1.5L21 8H6"/>
        </svg>

        <span
          class="cart-count"
          id="cartCount"
          aria-live="polite"
        >
          0
        </span>

      </a>

      <!-- LOGIN -->
      <a
        href="/login"
        class="header-btn"
      >
        Login
      </a>

      <!-- THEME TOGGLE -->
      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-label="Ganti tema"
      >

        <!-- SUN -->
        <svg
          class="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/>
          <path d="M12 20v2"/>
          <path d="M4.93 4.93l1.41 1.41"/>
          <path d="M17.66 17.66l1.41 1.41"/>
          <path d="M2 12h2"/>
          <path d="M20 12h2"/>
          <path d="M4.93 19.07l1.41-1.41"/>
          <path d="M17.66 6.34l1.41-1.41"/>
        </svg>

        <!-- MOON -->
        <svg
          class="moon"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M20 14.5A8.5 8.5 0 1 1 12.5 4A7 7 0 0 0 20 14.5z"/>
        </svg>

      </button>

    </div>

  </div>
</header>


<style is:global>

/* =========================================================
   HEADER ACTIONS
========================================================= */

.header-actions{
  display:flex;
  align-items:center;
  gap:10px;
}


/* =========================================================
   CART
========================================================= */

.cart-btn{
  position:relative;

  width:44px;
  height:44px;

  display:flex;
  align-items:center;
  justify-content:center;

  color:var(--text);
  background:var(--surface);

  border:1px solid var(--border);
  border-radius:10px;

  text-decoration:none;

  transition:
    background .25s ease,
    border-color .25s ease,
    transform .25s ease;
}

.cart-btn svg{
  width:21px;
  height:21px;
}

.cart-btn:hover{
  background:var(--surface-hover);
  border-color:var(--primary);
  transform:translateY(-1px);
}


/* =========================================================
   CART BADGE
========================================================= */

.cart-count{
  position:absolute;

  top:-6px;
  right:-6px;

  min-width:18px;
  height:18px;

  padding:0 4px;

  display:none;

  align-items:center;
  justify-content:center;

  border:2px solid var(--surface);
  border-radius:999px;

  background:var(--primary);
  color:#fff;

  font-size:10px;
  font-weight:800;
  line-height:1;

  pointer-events:none;
}


/* =========================================================
   LOGIN
========================================================= */

.header-btn{
  height:44px;

  padding:0 18px;

  display:flex;
  align-items:center;
  justify-content:center;

  color:var(--textbtn);
  background:var(--bgbtn);

  border-radius:10px;

  font-weight:600;
  text-decoration:none;

  white-space:nowrap;

  transition:
    filter .25s ease,
    transform .25s ease;
}

.header-btn:hover{
  filter:brightness(1.08);
  transform:translateY(-1px);
}


/* =========================================================
   DROPDOWN
========================================================= */

.dropdown{
  position:relative;
}

.drop-btn{
  display:flex;
  align-items:center;
  gap:5px;

  border:0;
  background:none;

  color:inherit;

  cursor:pointer;

  font:inherit;
}

.drop-btn svg{
  width:14px;
  height:14px;

  transition:
    transform .25s ease;
}

.dropdown:hover .drop-btn svg,
.dropdown:focus-within .drop-btn svg{
  transform:rotate(180deg);
}

.drop-menu{
  position:absolute;

  top:calc(100% + 10px);
  left:0;

  min-width:210px;

  padding:7px;

  background:var(--surface);

  border:1px solid var(--border);
  border-radius:12px;

  box-shadow:var(--shadow-lg);

  opacity:0;
  visibility:hidden;

  transform:translateY(-6px);

  transition:
    opacity .2s ease,
    transform .2s ease,
    visibility .2s ease;

  z-index:1000;
}

.dropdown:hover .drop-menu,
.dropdown:focus-within .drop-menu,
.dropdown.open .drop-menu{
  opacity:1;
  visibility:visible;

  transform:translateY(0);
}

.drop-menu a{
  display:block;

  padding:10px 12px;

  color:var(--text);

  border-radius:8px;

  text-decoration:none;

  font-size:13px;

  transition:
    background .2s ease,
    color .2s ease;
}

.drop-menu a:hover{
  background:var(--surface-hover);
  color:var(--primary);
}


/* =========================================================
   MOBILE MENU
========================================================= */

@media(max-width:900px){

  .header-wrap{
    gap:10px;
  }

  .menu-toggle{
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .nav{
    position:absolute;

    top:100%;
    left:0;
    right:0;

    display:none;

    flex-direction:column;

    padding:12px;

    background:var(--surface);

    border-top:1px solid var(--border);
    border-bottom:1px solid var(--border);

    box-shadow:var(--shadow-lg);

    z-index:999;
  }

  .nav.open{
    display:flex;
  }

  .nav > a,
  .dropdown{
    width:100%;
  }

  .drop-btn{
    width:100%;

    min-height:44px;

    justify-content:space-between;
  }

  .drop-menu{
    position:static;

    width:100%;

    margin:0;
    padding:0;

    border:0;
    box-shadow:none;

    opacity:1;
    visibility:visible;

    transform:none;

    display:none;
  }

  .dropdown.open .drop-menu{
    display:block;
  }

  .drop-menu a{
    padding:10px 14px;
  }

}


/* =========================================================
   SMALL SCREEN
========================================================= */

@media(max-width:600px){

  .header-actions{
    gap:6px;
  }

  .header-btn{
    height:40px;
    padding:0 13px;

    font-size:12px;
  }

  .cart-btn{
    width:40px;
    height:40px;
  }

}


/* =========================================================
   VERY SMALL SCREEN
========================================================= */

@media(max-width:420px){

  .header-btn{
    display:none;
  }

}

</style>


<script>

/* =========================================================
   CART STORAGE
========================================================= */

const CART_KEY = 'cart';


/* =========================================================
   UPDATE CART COUNT
========================================================= */

function updateCartCount(){

  const badge =
    document.getElementById('cartCount');

  if(!badge) return;


  try{

    const cart =
      JSON.parse(
        localStorage.getItem(CART_KEY) || '[]'
      );


    const count =
      Array.isArray(cart)
        ? cart.reduce(
            (total, item) =>
              total +
              Math.max(
                0,
                Number(item.quantity || 0)
              ),
            0
          )
        : 0;


    badge.textContent =
      count > 99
        ? '99+'
        : String(count);


    badge.style.display =
      count > 0
        ? 'flex'
        : 'none';


  }catch(error){

    console.error(
      'Cart error:',
      error
    );

    badge.textContent = '0';

    badge.style.display = 'none';

  }

}


/* =========================================================
   INITIALIZE HEADER
========================================================= */

function initHeader(){

  updateCartCount();


  /* =======================================================
     MOBILE MENU
  ======================================================= */

  const menuToggle =
    document.getElementById('menuToggle');

  const nav =
    document.getElementById('nav');


  menuToggle?.addEventListener(
    'click',
    (event) => {

      event.stopPropagation();


      const open =
        nav?.classList.toggle('open');


      menuToggle.setAttribute(
        'aria-expanded',
        String(!!open)
      );

    }
  );


  /* =======================================================
     DROPDOWN
  ======================================================= */

  document
    .querySelectorAll('.drop-btn')
    .forEach((button) => {

      button.addEventListener(
        'click',
        (event) => {

          event.stopPropagation();


          const dropdown =
            button.closest('.dropdown');


          if(!dropdown) return;


          const isOpen =
            dropdown.classList.contains('open');


          /* CLOSE OTHER DROPDOWNS */

          document
            .querySelectorAll(
              '.dropdown.open'
            )
            .forEach((item) => {

              if(item !== dropdown){

                item.classList.remove(
                  'open'
                );


                item
                  .querySelector('.drop-btn')
                  ?.setAttribute(
                    'aria-expanded',
                    'false'
                  );

              }

            });


          /* TOGGLE CURRENT */

          dropdown.classList.toggle(
            'open',
            !isOpen
          );


          button.setAttribute(
            'aria-expanded',
            String(!isOpen)
          );

        }
      );

    });


  /* =======================================================
     CLOSE MENU / DROPDOWN
  ======================================================= */

  document.addEventListener(
    'click',
    (event) => {

      const target =
        event.target;


      /* CLOSE DROPDOWNS */

      document
        .querySelectorAll(
          '.dropdown.open'
        )
        .forEach((dropdown) => {

          if(!dropdown.contains(target)){

            dropdown.classList.remove(
              'open'
            );


            dropdown
              .querySelector('.drop-btn')
              ?.setAttribute(
                'aria-expanded',
                'false'
              );

          }

        });


      /* CLOSE MOBILE NAV */

      if(
        nav &&
        nav.classList.contains('open') &&
        !nav.contains(target) &&
        !menuToggle?.contains(target)
      ){

        nav.classList.remove('open');

        menuToggle?.setAttribute(
          'aria-expanded',
          'false'
        );

      }

    }
  );


  /* =======================================================
     CART UPDATED EVENT
  ======================================================= */

  window.addEventListener(
    'cartUpdated',
    updateCartCount
  );


  /* =======================================================
     OTHER TAB / WINDOW
  ======================================================= */

  window.addEventListener(
    'storage',
    (event) => {

      if(
        event.key === CART_KEY
      ){

        updateCartCount();

      }

    }
  );

}


/* =========================================================
   ASTRO LOAD
========================================================= */

if(
  document.readyState === 'loading'
){

  document.addEventListener(
    'DOMContentLoaded',
    initHeader,
    { once:true }
  );

}else{

  initHeader();

}

</script>
