---
import { SITE } from "../lib/site";

const linkalt = "/";

const aboutItems = [
  { href: linkalt, label: "About" },
  { href: linkalt, label: "Technology" },
  { href: linkalt, label: "Security" },
  { href: linkalt, label: "Privacy" },
  { href: linkalt, label: "Disclaimer" },
  { href: linkalt, label: "Contact" },
];

const productItems = [
  { href: linkalt, label: "Roboragma APK" },
  { href: linkalt, label: "AI Tools" },
  { href: linkalt, label: "Gaming Tools" },
  { href: linkalt, label: "AI Assistant" },
  { href: linkalt, label: "Gamer Assistant" },
];

const featureItems = [
  { href: linkalt, label: "AI Analysis" },
  { href: linkalt, label: "AI Gaming" },
  { href: linkalt, label: "Game Analysis" },
  { href: linkalt, label: "Gaming Assistant" },
  { href: linkalt, label: "Android Tools" },
];

const downloadItems = [
  { href: linkalt, label: "Download APK" },
  { href: linkalt, label: "Latest Version" },
  { href: linkalt, label: "Installation" },
  { href: linkalt, label: "Update" },
  { href: linkalt, label: "Requirements" },
];

const guideItems = [
  { href: linkalt, label: "Getting Started" },
  { href: linkalt, label: "User Guide" },
  { href: linkalt, label: "Installation Guide" },
  { href: linkalt, label: "Update Guide" },
  { href: linkalt, label: "FAQ" },
];

const supportItems = [
  { href: linkalt, label: "Help Center" },
  { href: linkalt, label: "FAQ" },
  { href: linkalt, label: "Troubleshooting" },
  { href: linkalt, label: "Support" },
];

const menus = [
  { label: "Tentang", items: aboutItems },
  { label: "Produk", items: productItems },
  { label: "Fitur", items: featureItems },
  { label: "Download", items: downloadItems },
  { label: "Panduan", items: guideItems },
  { label: "Support", items: supportItems },
];
---

<header class="header">
  <div class="header-wrap">

    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
    >
      ☰
    </button>

    <a href={linkalt} class="header-logo">
      AI<span> Mr Ferdy</span>
    </a>

    <nav class="nav" id="nav">

      <a href={linkalt}>Home</a>

      {
        menus.map((menu) => (
          <div class="dropdown">

            <button
              class="drop-btn"
              type="button"
              aria-expanded="false"
            >
              {menu.label}

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>

            <div class="drop-menu">

              {
                menu.items.map((item) => (
                  <a href={item.href}>
                    {item.label}
                  </a>
                ))
              }

            </div>

          </div>
        ))
      }

    </nav>

    <div class="header-actions">

      <a href="/login" class="header-btn">
        Login
      </a>

      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-label="Ganti tema"
      >

        <svg
          class="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/>
          <path d="M12 20v2"/>
          <path d="M4.93 4.93l1.41 1.41"/>
          <path d="M17.66 17.66l1.41 1.41"/>
          <path d="M2 12h2"/>
          <path d="M20 12h2"/>
          <path d="M4.93 19.07l1.41-1.41"/>
          <path d="M17.66 6.34l1.41-1.41"/>
        </svg>

        <svg
          class="moon"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M20 14.5A8.5 8.5 0 1 1 12.5 4A7 7 0 0 0 20 14.5z"/>
        </svg>

      </button>

    </div>

  </div>
</header>

<style is:global>
.header-actions{display:flex;align-items:center;gap:10px}
.header-btn{
  height:44px;
  padding:0 18px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--textbtn);
  background:var(--bgbtn);
  border-radius:10px;
  font-weight:600;
  white-space:nowrap;
  transition:.25s
}
.header-btn:hover{filter:brightness(1.08)}
</style>
