---
import { SITE } from "../lib/site";

const linkalt = "/";

const blogItems = [
  { href: "/blog", label: "All Articles" },
  { href: "/blog/ai", label: "AI" },
  { href: "/blog/gaming", label: "Gaming" },
  { href: "/blog/technology", label: "Technology" },
];

const toolItems = [
  { href: "/tools", label: "All Tools" },
  { href: "/tools/ai", label: "AI Tools" },
  { href: "/tools/gaming", label: "Gaming Tools" },
  { href: "/tools/android", label: "Android Tools" },
];

const productItems = [
  { href: "/products", label: "All Products" },
  { href: "/products/roboragma", label: "Roboragma APK" },
  { href: "/products/ai-assistant", label: "AI Assistant" },
  { href: "/products/gamer-assistant", label: "Gamer Assistant" },
];

const menus = [
  { label: "Blog", items: blogItems },
  { label: "Tools", items: toolItems },
  { label: "Product", items: productItems },
];
---

<header class="header">
  <div class="header-wrap">

    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
    >
      ☰
    </button>

    <a href={linkalt} class="header-logo">
      AI<span> Mr Ferdy</span>
    </a>

    <nav class="nav" id="nav">

      <a href="/">Home</a>

      <a href="/recent">Recent</a>

      {
        menus.map((menu) => (
          <div class="dropdown">

            <button
              class="drop-btn"
              type="button"
              aria-expanded="false"
            >
              {menu.label}

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>

            <div class="drop-menu">
              {
                menu.items.map((item) => (
                  <a href={item.href}>
                    {item.label}
                  </a>
                ))
              }
            </div>

          </div>
        ))
      }

      <a href="/about">About</a>

    </nav>

    <div class="header-actions">

      <!-- CART -->
      <a
        href="/cart"
        class="cart-btn"
        aria-label="Shopping cart"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="9" cy="20" r="1"/>
          <circle cx="18" cy="20" r="1"/>
          <path d="M3 4h2l2.4 11.5a2 2 0 0 0 2 1.5h7.7a2 2 0 0 0 2-1.5L21 8H6"/>
        </svg>

        <span class="cart-count" id="cartCount">0</span>
      </a>

      <!-- LOGIN -->
      <a href="/login" class="header-btn">
        Login
      </a>

      <!-- THEME -->
      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-label="Ganti tema"
      >

        <svg
          class="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/>
          <path d="M12 20v2"/>
          <path d="M4.93 4.93l1.41 1.41"/>
          <path d="M17.66 17.66l1.41 1.41"/>
          <path d="M2 12h2"/>
          <path d="M20 12h2"/>
          <path d="M4.93 19.07l1.41-1.41"/>
          <path d="M17.66 6.34l1.41-1.41"/>
        </svg>

        <svg
          class="moon"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M20 14.5A8.5 8.5 0 1 1 12.5 4A7 7 0 0 0 20 14.5z"/>
        </svg>

      </button>

    </div>

  </div>
</header>

<style is:global>

.header-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

/* CART */

.cart-btn{
  width:44px;
  height:44px;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  color:var(--text);
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:10px;
  transition:.25s;
}

.cart-btn svg{
  width:21px;
  height:21px;
}

.cart-btn:hover{
  background:var(--surface-hover);
}

/* CART BADGE */

.cart-count{
  position:absolute;
  top:-5px;
  right:-5px;
  min-width:18px;
  height:18px;
  padding:0 4px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:999px;
  background:var(--primary);
  color:#fff;
  font-size:10px;
  font-weight:700;
  line-height:1;
}

/* LOGIN */

.header-btn{
  height:44px;
  padding:0 18px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--textbtn);
  background:var(--bgbtn);
  border-radius:10px;
  font-weight:600;
  white-space:nowrap;
  transition:.25s;
}

.header-btn:hover{
  filter:brightness(1.08);
}

</style>

<script>
  function updateCartCount() {
    try {
      const cart = JSON.parse(
        localStorage.getItem("cart") || "[]"
      );

      const count = cart.reduce(
        (total, item) => total + (item.quantity || 1),
        0
      );

      const badge = document.getElementById("cartCount");

      if (badge) {
        badge.textContent = count > 99 ? "99+" : count;
      }

    } catch {
      const badge = document.getElementById("cartCount");

      if (badge) {
        badge.textContent = "0";
      }
    }
  }

  document.addEventListener(
    "DOMContentLoaded",
    updateCartCount
  );

  window.addEventListener(
    "storage",
    updateCartCount
  );

  window.addEventListener(
    "cartUpdated",
    updateCartCount
  );
</script>
